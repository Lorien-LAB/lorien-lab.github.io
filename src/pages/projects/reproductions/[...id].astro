---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagList from '../../../components/TagList.astro';
import ReproductionPipeline from '../../../components/ReproductionPipeline.astro';
import ReproductionScore from '../../../components/ReproductionScore.astro';
import ReproductionCharts from '../../../components/ReproductionCharts.astro';
import ReproductionCaseStudyHeader from '../../../components/ReproductionCaseStudyHeader.astro';
import ReproductionVerdictGrid from '../../../components/ReproductionVerdictGrid.astro';
import ReproductionFactorEvidence from '../../../components/ReproductionFactorEvidence.astro';
import ReproductionStrategyFlow from '../../../components/ReproductionStrategyFlow.astro';
import ReproductionLimitations from '../../../components/ReproductionLimitations.astro';
import ReproductionExtensionPanel from '../../../components/ReproductionExtensionPanel.astro';
import ResearchNoteHero from '../../../components/reproduction-note/ResearchNoteHero.astro';
import InteractivePerformanceChart from '../../../components/reproduction-note/InteractivePerformanceChart.astro';
import OriginalStrategyStory from '../../../components/reproduction-note/OriginalStrategyStory.astro';
import ReproductionAuditStory from '../../../components/reproduction-note/ReproductionAuditStory.astro';
import OptimizationStory from '../../../components/reproduction-note/OptimizationStory.astro';
import ResearchAuditAppendix from '../../../components/reproduction-note/ResearchAuditAppendix.astro';
import { researchNoteData } from '../../../data/reproduction-research-note/stock-index-futures-roll-basis-timing';

export async function getStaticPaths() {
  const entries = await getCollection('reproductions');
  return entries.map((entry) => ({ params: { id: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'reproductions'> };
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const slugOf = (id: string) => id.split('/').pop() ?? id;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const caseStudy = entry.data.caseStudy;
const isResearchNoteV3 = entry.data.slug === 'stock-index-futures-roll-basis-timing';
const sourceLabel = entry.data.sourceType === 'academic' ? 'Academic Paper' : 'Broker Report';
const resultLabel = entry.data.result.replace(/(^|\s)\S/g, (letter) => letter.toUpperCase());
const visibilityLabel = entry.data.codeVisibility === 'partial' ? 'Partial Code Release' : entry.data.codeVisibility === 'private' ? 'Implementation Private' : 'Public Code';
const sourceLink = entry.data.sourceType === 'academic' ? (entry.data.paperUrl ?? entry.data.sourceUrl) : entry.data.sourceUrl;
const pageTitle = isResearchNoteV3 ? '股指期货滚贴水择时与市场情绪因子' : (caseStudy?.shortTitle ?? entry.data.title);

const [knowledge, notes, projects] = await Promise.all([getCollection('knowledge'), getCollection('notes'), getCollection('projects')]);
const resolveSlugs = <T extends { id: string }>(slugs: string[], collection: T[]) => slugs.flatMap((slug) => {
  const match = collection.find((candidate) => slugOf(candidate.id) === slug);
  return match ? [match] : [];
});
const relatedKnowledge = resolveSlugs(entry.data.relatedKnowledge, knowledge);
const relatedNotes = resolveSlugs(entry.data.relatedNotes, notes);
const relatedProjects = resolveSlugs(entry.data.relatedProjects, projects);
const artifactLinks = [
  entry.data.reportHtmlPath ? { label: 'Original HTML', href: withBase(entry.data.reportHtmlPath), external: false } : null,
  sourceLink ? { label: 'Source', href: sourceLink, external: true } : null,
  entry.data.codeVisibility !== 'private' && entry.data.codeUrl ? { label: caseStudy ? 'View Research Code' : 'View Code', href: entry.data.codeUrl, external: true } : null,
  entry.data.notebookUrl ? { label: 'Notebook', href: entry.data.notebookUrl, external: true } : null,
  entry.data.configurationUrl ? { label: 'Configuration', href: entry.data.configurationUrl, external: true } : null,
  entry.data.resultsUrl ? { label: caseStudy ? 'Full Reproduction Report' : 'Results', href: entry.data.resultsUrl, external: true } : null,
].filter(Boolean) as { label: string; href: string; external: boolean }[];
---
<BaseLayout title={`${pageTitle} · Lorien Lab`} description={entry.data.description}>
  {isResearchNoteV3 ? (
    <article class="research-note-v3">
      <ResearchNoteHero data={researchNoteData} entry={entry} />
      <InteractivePerformanceChart data={researchNoteData} />
      <OriginalStrategyStory data={researchNoteData} />
      <ReproductionAuditStory data={researchNoteData} />
      <OptimizationStory data={researchNoteData} />
      <ResearchAuditAppendix data={researchNoteData} entry={entry} />
    </article>
  ) : (
    <article class="reproduction-record">
      {caseStudy ? <ReproductionCaseStudyHeader entry={entry} /> : (
        <header class="record-head"><div class="container record-wrap">
          <a class="back" href={`${base}projects/reproductions/`}>← All reproductions</a>
          <div class="record-kicker"><span>{sourceLabel}</span><span>{entry.data.researchArea}</span></div>
          <h1>{entry.data.title}</h1><p>{entry.data.description}</p>
          <div class="source-meta">
            {entry.data.sourceType === 'academic' ? <><span>{entry.data.authors.join(' · ')}</span><span>{entry.data.year}</span></> : <><span>{entry.data.broker}</span><span>{entry.data.analysts.join(' · ')}</span><span>{entry.data.publishDate.toLocaleDateString('en-US')}</span></>}
          </div><TagList tags={entry.data.tags} />
        </div></header>
      )}

      <section class="record-status"><div class="container record-wrap status-grid">
        <div><div class="mono-label">Reproduction Status</div><div class="status-line"><strong>{resultLabel}</strong><span>{visibilityLabel}</span></div></div>
        <div class="facts">{entry.data.market && <span>Market · {entry.data.market}</span>}{entry.data.frequency && <span>Frequency · {entry.data.frequency}</span>}{entry.data.dataAvailability && <span>Data · {entry.data.dataAvailability}</span>}</div>
        <div class="pipeline"><ReproductionPipeline stage={entry.data.stage} /></div>
      </div></section>

      {caseStudy ? <div class="container legacy-case">
        <ReproductionVerdictGrid verdicts={caseStudy.verdicts} />
        {caseStudy.strategyFlow.length > 0 && <ReproductionStrategyFlow steps={caseStudy.strategyFlow} />}
        {caseStudy.factorEvidence.length > 0 && <ReproductionFactorEvidence factors={caseStudy.factorEvidence} />}
        {caseStudy.limitations.length > 0 && <ReproductionLimitations limitations={caseStudy.limitations} />}
        <main class="prose"><Content /></main>
        {caseStudy.extension && <ReproductionExtensionPanel extension={caseStudy.extension} />}
        {entry.data.score && <ReproductionScore score={entry.data.score} />}
      </div> : <div class="container generic-content">
        <main class="prose"><Content /></main>
        {(entry.data.metrics.length > 0 || entry.data.score) && <aside>
          {entry.data.metrics.length > 0 && <div class="metrics"><div class="mono-label">Original vs Reproduced</div>{entry.data.metrics.map((m)=><div><span>{m.name}</span><strong>{m.original} → {m.reproduced}</strong></div>)}</div>}
          {entry.data.score && <ReproductionScore score={entry.data.score} />}
        </aside>}
      </div>}

      <ReproductionCharts slug={entry.data.slug} />
      <section class="record-footer"><div class="container record-wrap footer-grid">
        <div><div class="mono-label">Artifacts</div><h2>Research outputs</h2>{artifactLinks.length > 0 ? <div class="artifact-links">{artifactLinks.map((a)=><a href={a.href} target={a.external?'_blank':undefined} rel={a.external?'noreferrer':undefined}>{a.label} →</a>)}</div> : <p>No public artifacts are linked yet.</p>}{entry.data.codeVisibility === 'private' && <div>Implementation Private</div>}</div>
        {(relatedKnowledge.length + relatedNotes.length + relatedProjects.length > 0) && <div><div class="mono-label">Connected Research</div><div class="relations">
          {relatedKnowledge.map((item)=><a href={`${base}knowledge/${slugOf(item.id)}/`}>{item.data.title} →</a>)}
          {relatedNotes.map((item)=><a href={`${base}notes/${slugOf(item.id)}/`}>{item.data.title} →</a>)}
          {relatedProjects.map((item)=><a href={`${base}projects/${slugOf(item.id)}/`}>{item.data.title} →</a>)}
        </div></div>}
      </div></section>
    </article>
  )}
</BaseLayout>

<style>
.record-wrap{max-width:1120px}.record-head{padding:60px 0;border-bottom:1px solid var(--border)}.record-head .back{display:inline-block;margin-bottom:32px;color:var(--muted);font-weight:700}.record-kicker{font:700 .65rem var(--font-mono);color:var(--accent-strong);text-transform:uppercase}.record-kicker span+span:before{content:' / '}.record-head h1{max-width:960px;margin:10px 0;font-size:clamp(2.4rem,6vw,4.7rem);line-height:.98;letter-spacing:-.055em}.record-head p{max-width:820px;color:var(--muted)}.source-meta{display:flex;gap:18px;flex-wrap:wrap;margin:24px 0;color:var(--muted);font:650 .67rem var(--font-mono)}.record-status{padding:28px 0;border-bottom:1px solid var(--border);background:var(--surface)}.status-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:22px}.status-line{display:flex;gap:12px;margin-top:7px;align-items:center}.status-line strong{font:800 1rem var(--font-mono);color:var(--accent-strong)}.status-line span{font:650 .6rem var(--font-mono);color:var(--muted)}.facts{display:flex;gap:14px;flex-wrap:wrap;color:var(--muted);font:650 .62rem var(--font-mono)}.pipeline{grid-column:1/-1}.legacy-case{max-width:1120px;padding-top:30px;padding-bottom:50px}.legacy-case>.prose{max-width:820px;margin:45px 0}.generic-content{display:grid;grid-template-columns:minmax(0,760px) minmax(280px,1fr);gap:55px;padding-top:55px;padding-bottom:55px}.generic-content aside{display:grid;gap:15px;align-content:start}.metrics{padding:18px;border:1px solid var(--border);border-radius:10px}.metrics>div:not(.mono-label){display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);font-size:.7rem}.record-footer{padding:48px 0;border-top:1px solid var(--border);background:var(--surface)}.footer-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px}.artifact-links,.relations{display:flex;gap:9px;flex-wrap:wrap}.artifact-links a,.relations a{padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:.73rem}
@media(max-width:800px){.status-grid,.generic-content,.footer-grid{grid-template-columns:1fr}}
</style>
