---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReproductionCard from '../../../components/ReproductionCard.astro';

const entries = (await getCollection('reproductions')).sort((a,b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf());
const academic = entries.filter((entry) => entry.data.sourceType === 'academic');
const broker = entries.filter((entry) => entry.data.sourceType === 'broker');
const progressed = entries.filter((entry) => ['reproduction','extension'].includes(entry.data.stage));
const successful = entries.filter((entry) => ['successful','extended'].includes(entry.data.result));
const featured = entries.filter((entry) => entry.data.featured).slice(0, 3);
const researchAreas = ['Factor Research','Asset Pricing','Stock Selection','Index Enhancement','CTA / Systematic Trading','Asset Allocation','Machine Learning','Market Microstructure','Derivatives','Portfolio Construction','Risk Management'];
const stageOptions = [['reading','Reading'],['data','Data'],['implementation','Implementation'],['validation','Validation'],['reproduction','Reproduction'],['extension','Extension']];
const resultOptions = [['successful','Successful'],['partial','Partial'],['failed','Failed'],['inconclusive','Inconclusive'],['extended','Extended']];
const visibilityOptions = [['public','Public'],['partial','Partial'],['private','Private']];
---
<BaseLayout title="Quant Research Reproductions · Lorien Lab" description="An auditable reproduction workbench for quantitative-finance academic papers and broker research reports.">
  <header class="repro-hero">
    <div class="container repro-hero-grid">
      <div class="repro-hero-copy">
        <h1>Quant Research<br/>Reproductions</h1>
        <p>Reproducing quantitative research, not merely summarizing it. Each record tracks source claims, data fidelity, implementation, validation, empirical reproduction, robustness, and extensions.</p>
        <a class="button primary" href="#reproduction-index">Browse reproductions →</a>
      </div>
      <div class="repro-summary" aria-label="Current reproduction library summary">
        <div><span>Academic Papers</span><strong>{academic.length}</strong></div>
        <div><span>Broker Reports</span><strong>{broker.length}</strong></div>
        <div><span>Reproduction+</span><strong>{progressed.length}</strong></div>
        <div><span>Successful / Extended</span><strong>{successful.length}</strong></div>
      </div>
    </div>
  </header>

  <section class="section source-section">
    <div class="container">
      <div class="section-intro"><div><div class="mono-label">Research Sources</div><h2>Two source families, one empirical standard.</h2></div><p>Academic papers and broker quantitative research share the same six-stage reproduction pipeline while preserving source-specific metadata and conventions.</p></div>
      <div class="source-split">
        <a class="source-panel academic-panel" href="#reproduction-index" data-source-jump="academic">
          <span class="source-code">A</span><div><h3>Academic Papers</h3><p>Journal · SSRN · arXiv · Conference</p><strong>{academic.length} {academic.length === 1 ? 'record' : 'records'} →</strong></div>
        </a>
        <a class="source-panel broker-panel" href="#reproduction-index" data-source-jump="broker">
          <span class="source-code">B</span><div><h3>Broker Reports</h3><p>Quantitative · Financial Engineering · Systematic Research</p><strong>{broker.length} {broker.length === 1 ? 'record' : 'records'} →</strong></div>
        </a>
      </div>
    </div>
  </section>

  {featured.length > 0 && <section class="section featured-reproductions"><div class="container"><div class="section-intro"><div><div class="mono-label">Selected Work</div><h2>Featured reproductions</h2></div><p>Research records highlighted for methodological depth, reproducibility, or meaningful extensions.</p></div><div class="reproduction-grid">{featured.map((entry) => <ReproductionCard entry={entry} />)}</div></div></section>}

  <section id="reproduction-index" class="section index-section">
    <div class="container">
      <div class="section-intro"><div><div class="mono-label">Reproduction Index</div><h2>Search the workbench</h2></div><p>All research records are rendered in static HTML. Filters progressively narrow the corpus in-browser without a server or external search service.</p></div>

      <div class="filter-bar" data-reproduction-controls>
        <label class="search-field"><span>Search</span><input type="search" placeholder="Title, broker, author, tags…" data-reproduction-search /></label>
        <label><span>Source Type</span><select data-source-filter><option value="">All sources</option><option value="academic">Academic</option><option value="broker">Broker</option></select></label>
        <label><span>Research Area</span><select data-area-filter><option value="">All areas</option>{researchAreas.map((area) => <option value={area}>{area}</option>)}</select></label>
        <label><span>Stage</span><select data-stage-filter><option value="">All stages</option>{stageOptions.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
        <label><span>Result</span><select data-result-filter><option value="">All results</option>{resultOptions.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
        <label><span>Code Visibility</span><select data-visibility-filter><option value="">All code states</option>{visibilityOptions.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
        <button type="button" class="reset-button" data-reproduction-reset>Reset</button>
      </div>

      {entries.length === 0 ? <div class="empty-library">
        <div class="empty-mark" aria-hidden="true"><span>01</span><span>02</span><span>03</span><span>04</span><span>05</span><span>06</span></div>
        <h3>Reproduction library initialized.</h3>
        <p>Research records will appear as reproductions are completed.</p>
      </div> : <div class="reproduction-list" data-reproduction-list>
        {entries.map((entry) => {
          const sourceNames = entry.data.sourceType === 'academic' ? entry.data.authors.join(' ') : [entry.data.broker, ...entry.data.analysts].join(' ');
          const searchText = [entry.data.title,entry.data.description,entry.data.researchArea,sourceNames,...entry.data.tags].join(' ').toLowerCase();
          return <div data-reproduction-row data-source={entry.data.sourceType} data-area={entry.data.researchArea} data-stage={entry.data.stage} data-result={entry.data.result} data-visibility={entry.data.codeVisibility} data-search={searchText}><ReproductionCard entry={entry} /></div>;
        })}
      </div>}
      <p class="no-results" data-no-results hidden>No reproduction records match the current filters.</p>
    </div>
  </section>

  <section class="section standard-section"><div class="container standard-grid"><div><div class="mono-label">Research Standard</div><h2>One pipeline from reading to extension.</h2><p>Each reproduction is treated as an auditable empirical research project rather than a summary.</p></div><ol><li><span>01</span>Reading</li><li><span>02</span>Data</li><li><span>03</span>Implementation</li><li><span>04</span>Validation</li><li><span>05</span>Reproduction</li><li><span>06</span>Extension</li></ol></div></section>
</BaseLayout>

<script is:inline>
(() => {
  const search = document.querySelector('[data-reproduction-search]');
  const source = document.querySelector('[data-source-filter]');
  const area = document.querySelector('[data-area-filter]');
  const stage = document.querySelector('[data-stage-filter]');
  const result = document.querySelector('[data-result-filter]');
  const visibility = document.querySelector('[data-visibility-filter]');
  const reset = document.querySelector('[data-reproduction-reset]');
  const rows = [...document.querySelectorAll('[data-reproduction-row]')];
  const noResults = document.querySelector('[data-no-results]');
  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    const tests = [
      ['source', source?.value || ''],
      ['area', area?.value || ''],
      ['stage', stage?.value || ''],
      ['result', result?.value || ''],
      ['visibility', visibility?.value || ''],
    ];
    let visibleCount = 0;
    rows.forEach((row) => {
      const matchesText = !q || row.dataset.search.includes(q);
      const matchesFilters = tests.every(([key, value]) => !value || row.dataset[key] === value);
      row.hidden = !(matchesText && matchesFilters);
      if (!row.hidden) visibleCount += 1;
    });
    if (noResults) noResults.hidden = rows.length === 0 || visibleCount !== 0;
  };
  [search, source, area, stage, result, visibility].forEach((control) => control?.addEventListener(control === search ? 'input' : 'change', apply));
  reset?.addEventListener('click', () => {
    [search, source, area, stage, result, visibility].forEach((control) => { if (control) control.value = ''; });
    apply(); search?.focus();
  });
  document.querySelectorAll('[data-source-jump]').forEach((link) => link.addEventListener('click', () => {
    if (source) source.value = link.dataset.sourceJump || '';
    apply();
  }));
})();
</script>

<style>
.repro-hero{position:relative;overflow:hidden;background:radial-gradient(circle at 78% 28%,#103249 0,#071a28 32%,var(--hero) 70%);color:var(--hero-ink);border-bottom:1px solid rgba(255,255,255,.08)}.repro-hero:after{content:'';position:absolute;right:-120px;top:-200px;width:760px;height:760px;border:1px solid rgba(78,230,177,.16);border-radius:50%;box-shadow:0 0 0 80px rgba(67,159,255,.035),0 0 0 160px rgba(67,159,255,.025)}.repro-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr .8fr;gap:70px;align-items:end;min-height:420px;padding-top:72px;padding-bottom:66px}.repro-hero-copy h1{margin:0;font:700 clamp(3rem,6vw,5.6rem)/.94 var(--font-mono);letter-spacing:-.065em}.repro-hero-copy p{max-width:760px;margin:24px 0 28px;color:#b8cad5;font:400 1rem/1.72 var(--font-mono)}.repro-summary{display:grid;grid-template-columns:1fr 1fr;border:1px solid rgba(255,255,255,.13);border-radius:14px;background:rgba(4,16,27,.67);backdrop-filter:blur(12px);overflow:hidden}.repro-summary div{padding:19px;border-right:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1)}.repro-summary div:nth-child(even){border-right:0}.repro-summary div:nth-last-child(-n+2){border-bottom:0}.repro-summary span{display:block;color:#93a8b5;font:600 .62rem var(--font-mono);text-transform:uppercase;letter-spacing:.05em}.repro-summary strong{display:block;margin-top:5px;color:var(--accent);font:800 1.7rem var(--font-mono)}
.section-intro{display:grid;grid-template-columns:1fr minmax(280px,520px);gap:50px;align-items:end;margin-bottom:30px}.section-intro h2{margin:7px 0 0;font-size:clamp(2rem,4vw,3.25rem);letter-spacing:-.05em}.section-intro>p{margin:0;color:var(--muted)}.source-split{display:grid;grid-template-columns:1fr 1fr;gap:18px}.source-panel{display:grid;grid-template-columns:64px 1fr;gap:22px;align-items:start;padding:27px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--ink);transition:transform .18s ease,border-color .18s ease}.source-panel:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 48%,var(--border));color:var(--ink)}.source-code{display:grid;place-items:center;width:54px;height:54px;border:1px solid var(--border);border-radius:50%;font:800 1rem var(--font-mono);color:var(--accent-strong)}.broker-panel .source-code{color:#287fbe}.source-panel h3{margin:1px 0 7px;font-size:1.35rem}.source-panel p{margin:0 0 20px;color:var(--muted);font:600 .77rem var(--font-mono)}.source-panel strong{font-size:.82rem;color:var(--accent-strong)}.reproduction-grid,.reproduction-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.featured-reproductions{background:color-mix(in srgb,var(--surface) 68%,transparent);border-block:1px solid var(--border)}
.filter-bar{display:grid;grid-template-columns:minmax(210px,1.45fr) repeat(5,minmax(120px,.7fr)) auto;gap:10px;align-items:end;padding:15px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);margin-bottom:24px}.filter-bar label{display:grid;gap:6px;min-width:0}.filter-bar label>span{font:700 .6rem var(--font-mono);text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.filter-bar input,.filter-bar select{width:100%;height:42px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--ink);padding:0 10px;font:600 .76rem var(--font-sans)}.reset-button{height:42px;padding:0 14px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--muted);font-weight:700;cursor:pointer}.reset-button:hover{border-color:var(--accent);color:var(--ink)}.empty-library{display:grid;place-items:center;text-align:center;min-height:310px;padding:50px;border:1px dashed color-mix(in srgb,var(--accent) 38%,var(--border));border-radius:var(--radius-lg);background:linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--accent-soft) 24%,var(--surface)))}.empty-library h3{margin:22px 0 7px;font-size:1.5rem}.empty-library p{margin:0;color:var(--muted)}.empty-mark{display:flex;gap:6px}.empty-mark span{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--border);border-radius:50%;font:700 .58rem var(--font-mono);color:var(--muted)}.empty-mark span:first-child{border-color:var(--accent);color:var(--accent-strong);background:var(--accent-soft)}.no-results{margin:25px 0;color:var(--muted);font-style:italic}.standard-section{padding-top:12px}.standard-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:70px;align-items:start;padding-top:48px;border-top:1px solid var(--border)}.standard-grid h2{margin:8px 0 14px;font-size:clamp(2rem,4vw,3.2rem);line-height:1.05;letter-spacing:-.05em}.standard-grid p{color:var(--muted);max-width:520px}.standard-grid ol{padding:0;margin:0;list-style:none;border-top:1px solid var(--border)}.standard-grid li{display:grid;grid-template-columns:52px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);font-weight:750}.standard-grid li span{font:700 .7rem var(--font-mono);color:var(--accent-strong)}
@media(max-width:1180px){.filter-bar{grid-template-columns:repeat(3,1fr)}.search-field{grid-column:span 2}.reproduction-grid,.reproduction-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:820px){.repro-hero-grid,.section-intro,.standard-grid{grid-template-columns:1fr;gap:34px}.repro-hero-grid{align-items:start}.source-split{grid-template-columns:1fr}.filter-bar{grid-template-columns:1fr 1fr}.search-field{grid-column:1/-1}.reproduction-grid,.reproduction-list{grid-template-columns:1fr}}@media(max-width:520px){.repro-summary{grid-template-columns:1fr 1fr}.filter-bar{grid-template-columns:1fr}.search-field{grid-column:auto}.source-panel{grid-template-columns:48px 1fr;padding:20px}.source-code{width:42px;height:42px}}
</style>
