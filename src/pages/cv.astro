---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="CV · Xiang Luo" description="Web CV for Xiang Luo, focused on quantitative research and financial engineering."><header class="page-hero"><div class="container cv-head"><div><div class="mono-label">Curriculum Vitae</div><h1>Research profile.</h1><p>This web CV is intentionally structured around research capability. Replace the editable fields below with your verified education, experience, and contact details before publishing.</p></div></div></header><div class="container cv-wrap"><section><h2>Education</h2><div class="cv-entry"><div><strong>Financial Engineering</strong><span>Your university · Degree and dates</span></div><p>Use this space for degree details, relevant coursework, honors, exchange study, or thesis information you want to publish.</p></div></section><section><h2>Research & Project Experience</h2><div class="cv-entry"><div><strong>Quantitative Research Systems</strong><span>Independent / academic project</span></div><p>Factor research infrastructure, automated discovery loops, systematic strategy research, and reproducible experiment design.</p></div><div class="cv-entry"><div><strong>Futures & Systematic Strategy Research</strong><span>Research portfolio</span></div><p>Term structure, spread state modeling, CTA trend/reversal research, risk scaling, and microstructure-derived daily alpha.</p></div></section><section><h2>Technical Skills</h2><div class="skill-lines"><p><strong>Research:</strong> factor mining, cross-sectional testing, time-series modeling, portfolio construction, backtesting, validation</p><p><strong>Programming:</strong> Python, data pipelines, ML tooling, research automation</p><p><strong>Methods:</strong> statistics, machine learning, optimization, time series, market microstructure</p></div></section><section><h2>Research Interests</h2><div class="interest-grid"><span>Alpha Discovery</span><span>Futures</span><span>Market Microstructure</span><span>CTA</span><span>Machine Learning</span><span>Agentic Research Systems</span></div></section></div></BaseLayout>
<style>.cv-head{display:flex;justify-content:space-between;align-items:end;gap:40px}.cv-head>div{max-width:780px}.cv-wrap{max-width:980px;padding-top:52px}.cv-wrap section{display:grid;grid-template-columns:220px 1fr;gap:40px;padding:34px 0;border-bottom:1px solid var(--border)}.cv-wrap h2{margin:0;font-size:1rem;font-family:var(--font-mono);color:var(--accent-strong)}.cv-entry{margin-bottom:26px}.cv-entry:last-child{margin-bottom:0}.cv-entry>div{display:flex;justify-content:space-between;gap:24px}.cv-entry span{color:var(--muted);font-size:.86rem}.cv-entry p,.skill-lines p{margin:7px 0 0;color:var(--muted)}.interest-grid{display:flex;flex-wrap:wrap;gap:9px}.interest-grid span{padding:7px 11px;background:var(--surface);border:1px solid var(--border);border-radius:999px;font-size:.82rem}.pdf-note{margin:32px 0;color:var(--muted);font-size:.85rem}.pdf-note code{font-family:var(--font-mono)}@media(max-width:720px){.cv-head{align-items:flex-start;flex-direction:column}.cv-wrap section{grid-template-columns:1fr;gap:15px}.cv-entry>div{flex-direction:column;gap:2px}}</style>
