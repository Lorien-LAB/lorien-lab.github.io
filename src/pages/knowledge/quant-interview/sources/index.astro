---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getProblemsForSource, slugOf, validateProblemRelationships } from '../../../../lib/problemRelations';

const base = import.meta.env.BASE_URL;
const problems = await getCollection('problems');
const sources = await getCollection('problemSources');
const knowledge = await getCollection('knowledge');
validateProblemRelationships(problems, sources, knowledge);
const rows = sources
  .map((source) => ({ source, count: getProblemsForSource(problems, slugOf(source.id)).length }))
  .sort((a, b) => a.source.data.shortTitle.localeCompare(b.source.data.shortTitle));
---
<BaseLayout title="Quant Interview Sources · Lorien Lab" description="Source provenance and indexed problem coverage for the Quant Interview Knowledge System.">
  <header class="page-hero"><div class="container"><div class="mono-label">Quant Interview · Sources</div><h1>Sources preserve<br/>provenance.</h1><p>Books and interview collections remain source records. Canonical problem pages and reusable knowledge live elsewhere in the graph.</p></div></header>
  <section class="section"><div class="container">
    <div class="section-heading"><div><div class="mono-label">Source Library</div><h2>Indexed sources</h2><p>Counts are derived from reviewed public Problem records. Empty sources remain visible as empty containers.</p></div><a class="section-link" href={`${base}knowledge/quant-interview/`}>Quant Interview Hub →</a></div>
    <div class="source-list">
      {rows.map(({ source, count }) => <a href={`${base}knowledge/quant-interview/sources/${slugOf(source.id)}/`}>
        <div><span>{source.data.sourceType}</span><h3>{source.data.shortTitle}</h3><p>{source.data.description}</p></div>
        <div class="count"><strong>{count}</strong><span>indexed {count === 1 ? 'problem' : 'problems'}</span></div>
        <i>→</i>
      </a>)}
    </div>
  </div></section>
</BaseLayout>
<style>
.source-list{border-top:1px solid var(--border)}.source-list>a{display:grid;grid-template-columns:minmax(0,1fr) 110px 24px;gap:22px;align-items:center;padding:22px 4px;border-bottom:1px solid var(--border);color:var(--ink)}.source-list>a:hover{color:var(--ink);background:color-mix(in srgb,var(--surface) 68%,transparent)}.source-list span{color:var(--muted);font:650 .66rem var(--font-mono);text-transform:uppercase}.source-list h3{margin:5px 0 5px;font-size:1.05rem}.source-list p{margin:0;color:var(--muted);font-size:.85rem}.count{text-align:right}.count strong{display:block;color:var(--accent-strong);font:800 1.4rem var(--font-mono)}.count span{font-size:.6rem}.source-list i{font-style:normal;color:var(--accent-strong)}@media(max-width:640px){.source-list>a{grid-template-columns:1fr 72px 20px}}
</style>
