---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import LearningResourcesGateway from '../../components/LearningResourcesGateway.astro';
import QuantInterviewGateway from '../../components/QuantInterviewGateway.astro';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('knowledge')).sort((a,b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf());
const featured = entries.filter((entry) => entry.data.featured).slice(0, 3);
const slugOf = (id: string) => id.split('/').pop() ?? id;
const typeLabel = (type: string) => type === 'topic' ? 'Research Topic' : type[0].toUpperCase() + type.slice(1);
const domains = [
  { name: 'Quantitative Finance', categories: ['Factor Investing','Asset Pricing','Portfolio Construction','Futures & Derivatives','CTA / Systematic Trading','Market Microstructure','Risk Management'] },
  { name: 'Mathematics & Statistics', categories: ['Probability','Stochastic Processes','Optimization','Time Series','Econometrics','Linear Algebra','Numerical Methods'] },
  { name: 'Machine Learning', categories: ['Tree Models','Deep Learning','Representation Learning','Time-Series ML','Reinforcement Learning','Model Validation'] },
  { name: 'AI & Research Agents', categories: ['LLM','Agent Architecture','Loop Engineering','RAG / Knowledge Systems','Genetic Programming','Automated Factor Discovery'] },
  { name: 'Research Infrastructure', categories: ['Backtesting','Data Engineering','Factor Libraries','Experiment Tracking','Quant Platforms','Research Workflows'] },
];
const domainCounts = Object.fromEntries(domains.map((domain) => [domain.name, entries.filter((entry) => entry.data.domain === domain.name).length]));
const typeCounts = Object.fromEntries(['concept','paper','tool','topic'].map((type) => [type, entries.filter((entry) => entry.data.type === type).length]));
---
<BaseLayout title="Knowledge Base · Lorien Lab" description="A connected research library for quantitative finance, mathematics, machine learning, AI research agents, and quantitative research infrastructure.">
  <header class="knowledge-hero">
    <div class="container hero-layout">
      <div>
        <div class="mono-label">Knowledge Base</div>
        <h1>A connected<br/>research library.</h1>
        <p>Structured concepts, papers, tools, and research topics across quantitative finance, mathematics, machine learning, and research systems.</p>
        <a class="button primary" href="#knowledge-index">Browse Knowledge →</a>
      </div>
      <div class="hero-side">
        <div class="obsidian-preview" aria-label="Obsidian Knowledge Graph coming soon"><span class="mono-label">Obsidian Knowledge Graph</span><strong>Coming Soon</strong><p>The full research graph stays connected behind the public library.</p></div>
        <div class="type-tally">{Object.entries(typeCounts).map(([type,count]) => <div><span>{typeLabel(type)}</span><strong>{count}</strong></div>)}</div>
      </div>
    </div>
  </header>

  <section class="section"><div class="container"><QuantInterviewGateway href={`${base}knowledge/quant-interview/`} /></div></section>
  <section class="section"><div class="container"><LearningResourcesGateway href={`${base}knowledge/financial-engineering-learning-resources/`} /></div></section>

  <section class="section domain-section"><div class="container">
    <div class="section-intro"><div><div class="mono-label">Knowledge Map</div><h2>Explore by domain</h2></div><p>Browse the library by research area, then narrow the index by type or search across titles, descriptions, tags, and categories.</p></div>
    <div class="domain-rail">{domains.map((domain, index) => <a class="domain-block" href="#knowledge-index" data-domain-jump={domain.name}><span>{String(index + 1).padStart(2,'0')}</span><div><h3>{domain.name}</h3><p>{domain.categories.join(' · ')}</p></div><strong>{domainCounts[domain.name]}</strong><i>→</i></a>)}</div>
  </div></section>

  {featured.length > 0 && <section class="section featured-section"><div class="container"><div class="section-intro"><div><div class="mono-label">Selected Knowledge</div><h2>Featured entries</h2></div><p>Compact, reusable knowledge objects connected to research and tooling across the portfolio.</p></div><div class="knowledge-grid">{featured.map((entry) => <KnowledgeCard entry={entry} />)}</div></div></section>}

  <section id="knowledge-index" class="section"><div class="container">
    <div class="section-intro"><div><div class="mono-label">Knowledge Index</div><h2>Search the library</h2></div><p>The general index remains focused on concepts, papers, tools, and research topics. Interview Problems live in the dedicated Problem Bank.</p></div>
    <div class="filter-bar">
      <label><span>Search knowledge</span><input type="search" placeholder="Search concepts, tools, tags…" data-knowledge-search /></label>
      <label><span>Type</span><select data-type-filter><option value="">All types</option><option value="concept">Concepts</option><option value="paper">Papers</option><option value="tool">Tools</option><option value="topic">Research topics</option></select></label>
      <label><span>Domain</span><select data-domain-filter><option value="">All domains</option>{domains.map((domain) => <option value={domain.name}>{domain.name}</option>)}</select></label>
      <button type="button" data-filter-reset>Reset</button>
    </div>
    <div class="index-list">{entries.map((entry) => {
      const searchText = [entry.data.title,entry.data.description,entry.data.domain,entry.data.category,...entry.data.tags].join(' ').toLowerCase();
      return <a class="index-row" href={`${base}knowledge/${slugOf(entry.id)}/`} data-knowledge-row data-type={entry.data.type} data-domain={entry.data.domain} data-search={searchText}><div><span>{typeLabel(entry.data.type)}</span><small>{entry.data.status}</small></div><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><div><strong>{entry.data.domain}</strong><span>{entry.data.category}</span></div><i>→</i></a>;
    })}</div>
    <p data-no-results hidden>No entries match the current filters.</p>
  </div></section>
</BaseLayout>
<script is:inline>
(() => {
  const search = document.querySelector('[data-knowledge-search]');
  const typeFilter = document.querySelector('[data-type-filter]');
  const domainFilter = document.querySelector('[data-domain-filter]');
  const reset = document.querySelector('[data-filter-reset]');
  const rows = [...document.querySelectorAll('[data-knowledge-row]')];
  const noResults = document.querySelector('[data-no-results]');
  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    const type = typeFilter?.value || '';
    const domain = domainFilter?.value || '';
    let visible = 0;
    rows.forEach((row) => { const matches = (!q || (row.dataset.search || '').includes(q)) && (!type || row.dataset.type === type) && (!domain || row.dataset.domain === domain); row.hidden = !matches; if (matches) visible += 1; });
    if (noResults) noResults.hidden = visible !== 0;
  };
  [search,typeFilter,domainFilter].forEach((control) => control?.addEventListener(control === search ? 'input' : 'change', apply));
  reset?.addEventListener('click', () => { if (search) search.value=''; if (typeFilter) typeFilter.value=''; if (domainFilter) domainFilter.value=''; apply(); });
  document.querySelectorAll('[data-domain-jump]').forEach((link) => link.addEventListener('click', () => { if (domainFilter) domainFilter.value = link.dataset.domainJump || ''; apply(); }));
})();
</script>
<style>
.knowledge-hero{padding:64px 0;background:radial-gradient(circle at 72% 28%,#0c2a3a 0,#071723 38%,var(--hero) 72%);color:var(--hero-ink)}.hero-layout{display:grid;grid-template-columns:1fr .85fr;gap:64px;align-items:center}.knowledge-hero h1{margin:10px 0 18px;font:700 clamp(3rem,6vw,5.5rem)/.94 var(--font-mono);letter-spacing:-.06em}.knowledge-hero p{max-width:690px;color:#bfd0da}.hero-side{display:grid;gap:15px}.obsidian-preview{padding:22px;border:1px solid rgba(255,255,255,.15);border-radius:var(--radius);background:rgba(5,18,29,.65)}.obsidian-preview strong{display:block;margin:7px 0;color:#60a8ff}.type-tally{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)}.type-tally div{padding:12px}.type-tally span{display:block;color:#8fa5b2;font:600 .62rem var(--font-mono)}.type-tally strong{display:block;color:var(--accent);font:800 1.2rem var(--font-mono)}.section-intro{display:grid;grid-template-columns:1fr minmax(260px,520px);gap:45px;align-items:end;margin-bottom:26px}.section-intro h2{margin:6px 0 0;font-size:clamp(1.8rem,4vw,3rem)}.section-intro>p{margin:0;color:var(--muted)}.domain-rail,.index-list{border-top:1px solid var(--border)}.domain-block{display:grid;grid-template-columns:50px 1fr 60px 20px;gap:18px;align-items:center;padding:18px 3px;border-bottom:1px solid var(--border);color:var(--ink)}.domain-block>span,.domain-block i{color:var(--accent-strong);font:700 .68rem var(--font-mono)}.domain-block h3{margin:0 0 4px}.domain-block p{margin:0;color:var(--muted);font-size:.8rem}.domain-block>strong{text-align:right}.domain-block i{font-style:normal}.featured-section{background:color-mix(in srgb,var(--surface) 70%,transparent);border-block:1px solid var(--border)}.knowledge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.filter-bar{display:grid;grid-template-columns:1fr 180px 240px auto;gap:12px;align-items:end;padding:15px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);margin-bottom:20px}.filter-bar label{display:grid;gap:6px}.filter-bar label>span{color:var(--muted);font:700 .64rem var(--font-mono);text-transform:uppercase}.filter-bar input,.filter-bar select,.filter-bar button{height:42px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--ink);padding:0 10px}.index-row{display:grid;grid-template-columns:120px 1fr 230px 20px;gap:18px;align-items:center;padding:17px 3px;border-bottom:1px solid var(--border);color:var(--ink)}.index-row>div:first-child span{display:block;color:var(--accent-strong);font:700 .67rem var(--font-mono)}.index-row small{color:var(--muted)}.index-row h3{margin:0 0 4px}.index-row p{margin:0;color:var(--muted);font-size:.83rem}.index-row>div:nth-child(3){display:grid}.index-row>div:nth-child(3) span{color:var(--muted);font-size:.75rem}.index-row i{font-style:normal;color:var(--accent-strong)}@media(max-width:900px){.hero-layout,.section-intro{grid-template-columns:1fr}.knowledge-grid{grid-template-columns:repeat(2,1fr)}.filter-bar{grid-template-columns:1fr 1fr}.index-row{grid-template-columns:100px 1fr 20px}.index-row>div:nth-child(3){display:none}}@media(max-width:640px){.knowledge-grid,.filter-bar{grid-template-columns:1fr}.index-row{grid-template-columns:1fr 20px}.index-row>div:first-child{display:none}}
</style>
