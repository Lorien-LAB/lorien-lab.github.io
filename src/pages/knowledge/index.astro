---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import LearningResourcesGateway from '../../components/LearningResourcesGateway.astro';
import QuantInterviewGateway from '../../components/QuantInterviewGateway.astro';
import LeetCodeGateway from '../../components/LeetCodeGateway.astro';
import { getKnowledgeDomains } from '../../lib/knowledgeLibrary.mjs';
import { typeLabels, statusLabelsZh, categoryLabelsZh, featuredKnowledgeZh } from '../../data/i18n/knowledgeUi.mjs';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('knowledge')).sort((a,b) => (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf());
const featured = entries.filter((entry) => entry.data.featured).slice(0, 3);
const domains = getKnowledgeDomains(entries);
const slugOf = (id: string) => id.split('/').pop() ?? id;
const typeCounts = Object.fromEntries(Object.keys(typeLabels).map((type) => [type, entries.filter((entry) => entry.data.type === type).length]));
const visibleTypeCounts = Object.entries(typeCounts).filter(([, count]) => count > 0);
---
<BaseLayout title="Knowledge Base · Lorien Lab" description="A connected research library for quantitative finance, mathematics, machine learning, AI research agents, and research infrastructure.">
  <header class="knowledge-hero">
    <div class="container">
      <h1><span class="lang-en">Knowledge library.</span><span class="lang-zh" lang="zh-CN">知识库。</span></h1>
      <p><span class="lang-en">Find concepts, tools and research methods, then explore their applications.</span><span class="lang-zh" lang="zh-CN">查找概念、工具与研究方法，连接理论与实践。</span></p>
      <div class="type-tally" aria-label="Entry counts / 条目数量">{visibleTypeCounts.map(([type,count]) => <span><strong>{count}</strong> <span class="lang-en">{typeLabels[type].en}{count === 1 ? '' : 's'}</span><span class="lang-zh" lang="zh-CN">{typeLabels[type].zh}</span></span>)}</div>
    </div>
  </header>
  <section id="knowledge-index" class="section index-section">
    <div class="container">
      <h2 class="sr-only"><span class="lang-en">Search the library</span><span class="lang-zh" lang="zh-CN">搜索知识库</span></h2>
      <form class="filter-bar" data-knowledge-controls role="search">
        <label class="search-field"><span class="lang-en">Search knowledge</span><span class="lang-zh" lang="zh-CN">搜索知识</span><input type="search" name="q" placeholder="Search concepts, tools, tags…" data-label-en="Search concepts, tools, tags…" data-label-zh="搜索概念、工具、标签…" data-knowledge-search /></label>
        <label><span class="lang-en">Type</span><span class="lang-zh" lang="zh-CN">类型</span><select name="type" data-type-filter>
          <option value="" data-label-en="All types" data-label-zh="全部类型">All types</option>
          {Object.entries(typeLabels).map(([type, labels]) => <option value={type} data-label-en={labels.en} data-label-zh={labels.zh}>{labels.en}</option>)}
        </select></label>
        <label><span class="lang-en">Domain</span><span class="lang-zh" lang="zh-CN">领域</span><select name="domain" data-domain-filter>
          <option value="" data-label-en="All domains" data-label-zh="全部领域">All domains</option>
          {domains.map((domain) => <option value={domain.name} data-label-en={`${domain.name} (${domain.count})`} data-label-zh={`${domain.zh}（${domain.count}）`}>{domain.name} ({domain.count})</option>)}
        </select></label>
        <button type="button" class="reset-button" data-filter-reset><span class="lang-en">Reset</span><span class="lang-zh" lang="zh-CN">重置</span></button>
      </form>
      <p class="result-count" role="status" aria-live="polite"><strong data-knowledge-count>{entries.length}</strong> <span class="lang-en">entries shown</span><span class="lang-zh" lang="zh-CN">条结果</span></p>
      <nav class="topic-shortcuts" aria-label="Learning paths / 学习路径">
        <QuantInterviewGateway compact href={`${base}knowledge/quant-interview/`} />
        <LeetCodeGateway compact href={`${base}knowledge/leetcode/`} />
        <LearningResourcesGateway compact href={`${base}knowledge/financial-engineering-learning-resources/`} />
      </nav>
      <div class="index-list" data-knowledge-list>
        {entries.map((entry) => {
          const zh = featuredKnowledgeZh[slugOf(entry.id)];
          const domain = domains.find((domain) => domain.name === entry.data.domain);
          const searchText = [entry.data.title,entry.data.description,entry.data.domain,entry.data.category,domain?.zh,zh?.title,zh?.description,categoryLabelsZh[entry.data.category],...entry.data.tags].filter(Boolean).join(' ').toLowerCase();
          return <a class="index-row" href={`${base}knowledge/${slugOf(entry.id)}/`} data-knowledge-row data-type={entry.data.type} data-domain={entry.data.domain} data-search={searchText}>
            <div class="row-type"><span class="lang-en">{typeLabels[entry.data.type].en}</span><span class="lang-zh" lang="zh-CN">{typeLabels[entry.data.type].zh}</span><small><span class="lang-en">{entry.data.status}</span><span class="lang-zh" lang="zh-CN">{statusLabelsZh[entry.data.status]}</span></small></div>
            <div class="row-main"><h3>{zh ? <><span class="lang-en">{entry.data.title}</span><span class="lang-zh" lang="zh-CN">{zh.title}</span></> : entry.data.title}</h3><p>{zh ? <><span class="lang-en">{entry.data.description}</span><span class="lang-zh" lang="zh-CN">{zh.description}</span></> : entry.data.description}</p></div>
            <div class="row-domain"><strong><span class="lang-en">{entry.data.domain}</span><span class="lang-zh" lang="zh-CN">{domain?.zh}</span></strong><span class="lang-en">{entry.data.category}</span><span class="lang-zh" lang="zh-CN">{categoryLabelsZh[entry.data.category] ?? entry.data.category}</span></div>
          </a>;
        })}
      </div>
      <p class="no-results" data-no-results hidden><span class="lang-en">No entries match the current filters.</span><span class="lang-zh" lang="zh-CN">没有符合当前筛选条件的条目。</span></p>
    </div>
  </section>
  {featured.length > 0 && <section class="section featured-section"><div class="container">
    <h2><span class="lang-en">Featured entries</span><span class="lang-zh" lang="zh-CN">精选条目</span></h2>
    <div class="knowledge-grid">{featured.map((entry) => <KnowledgeCard entry={entry} />)}</div>
  </div></section>}
</BaseLayout>

<script>
  import { readKnowledgeFilters, updateKnowledgeUrl } from '../../lib/knowledgeLibrary.mjs';

  const controls = document.querySelector<HTMLFormElement>('[data-knowledge-controls]')!;
  const search = document.querySelector<HTMLInputElement>('[data-knowledge-search]')!;
  const typeFilter = document.querySelector<HTMLSelectElement>('[data-type-filter]')!;
  const domainFilter = document.querySelector<HTMLSelectElement>('[data-domain-filter]')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-knowledge-row]')];
  const noResults = document.querySelector<HTMLElement>('[data-no-results]')!;
  const count = document.querySelector<HTMLElement>('[data-knowledge-count]')!;
  const domains = [...domainFilter.options].map(({ value }) => ({ name: value }));

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const matches = (!q || row.dataset.search?.includes(q)) && (!typeFilter.value || row.dataset.type === typeFilter.value) && (!domainFilter.value || row.dataset.domain === domainFilter.value);
      row.hidden = !matches;
      if (matches) visible += 1;
    });
    count.textContent = String(visible);
    noResults.hidden = visible !== 0;
  };
  const restore = () => {
    const filters = readKnowledgeFilters(location.search, domains);
    search.value = filters.q;
    typeFilter.value = filters.type;
    domainFilter.value = filters.domain;
    apply();
  };
  const save = (mode: 'pushState' | 'replaceState') => {
    const url = updateKnowledgeUrl(location.href, { q: search.value, type: typeFilter.value, domain: domainFilter.value });
    if (url.href !== location.href) history[mode](null, '', url);
    apply();
  };
  const localize = () => {
    const language = document.documentElement.dataset.lang === 'zh' ? 'zh' : 'en';
    controls.querySelectorAll<HTMLOptionElement | HTMLInputElement>('[data-label-en]').forEach((element) => {
      const label = (language === 'zh' ? element.dataset.labelZh : element.dataset.labelEn) ?? '';
      if (element instanceof HTMLInputElement) element.placeholder = label;
      else element.textContent = label;
    });
  };
  controls.addEventListener('submit', (event) => { event.preventDefault(); save('pushState'); });
  search.addEventListener('input', () => save('replaceState'));
  [typeFilter, domainFilter].forEach((filter) => filter.addEventListener('change', () => save('pushState')));
  document.querySelector('[data-filter-reset]')!.addEventListener('click', () => {
    search.value = ''; typeFilter.value = ''; domainFilter.value = '';
    save('pushState'); search.focus();
  });
  window.addEventListener('popstate', restore);
  window.addEventListener('pageshow', restore);
  window.addEventListener('site-language-change', localize);
  restore(); localize();
  controls.dataset.ready = 'true';
</script>

<style>
  .knowledge-hero { padding: 32px 0 24px; border-bottom: 1px solid var(--border); }
  .knowledge-hero h1 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -.04em; }
  .knowledge-hero p { margin: 12px 0 0; color: var(--muted); }
  .type-tally { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 16px; color: var(--muted); font-size: .8rem; }
  .type-tally strong { color: var(--ink); }
  .index-section { padding-top: 24px; }
  .filter-bar { display: grid; grid-template-columns: minmax(220px,1fr) 160px minmax(210px,280px) auto; gap: 12px; align-items: end; }
  .filter-bar label { display: grid; gap: 6px; font-size: .8rem; font-weight: 650; }
  .filter-bar input,.filter-bar select,.reset-button { width: 100%; min-width: 0; height: 44px; padding: 0 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); font: inherit; }
  .reset-button { width: auto; cursor: pointer; }
  .reset-button:hover { border-color: var(--accent-strong); }
  .result-count { margin: 12px 0; color: var(--muted); font-size: .82rem; }
  .topic-shortcuts { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 12px 0 18px; }
  .topic-shortcuts :global(a) { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent-strong); font-size: .88rem; font-weight: 650; }
  .index-list { border-top: 1px solid var(--border); }
  .index-row { display: grid; grid-template-columns: 110px minmax(0,1fr) minmax(160px,.35fr); gap: 20px; align-items: start; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .index-row:hover { background: var(--surface); color: var(--ink); }
  .index-row:hover h3 { color: var(--accent-strong); }
  .row-type { font-size: .75rem; color: var(--accent-strong); }
  .row-type small { display: block; margin-top: 4px; color: var(--muted); }
  .row-main h3 { margin: 0 0 6px; font-size: 1rem; line-height: 1.4; }
  .row-main p { margin: 0; color: var(--muted); font-size: .86rem; line-height: 1.6; }
  .row-domain { color: var(--muted); font-size: .78rem; }
  .row-domain strong { display: block; margin-bottom: 5px; color: var(--ink); }
  .no-results { padding: 28px 0; color: var(--muted); }
  .featured-section { border-top: 1px solid var(--border); }
  .featured-section h2 { margin: 0 0 20px; }
  .knowledge-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  @media(max-width:960px) { .filter-bar { grid-template-columns: 1fr 1fr auto; }.search-field { grid-column: 1/-1; }.index-row { grid-template-columns: 90px minmax(0,1fr); }.row-domain { grid-column: 2; }.knowledge-grid { grid-template-columns: 1fr; } }
  @media(max-width:560px) { .knowledge-hero { padding: 24px 0 20px; }.filter-bar { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }.reset-button { justify-self: start; }.topic-shortcuts { gap: 0 20px; }.index-row { grid-template-columns: 1fr; gap: 8px; }.row-domain { grid-column: auto; }.row-type small { display: inline; margin-left: 10px; } }
</style>
