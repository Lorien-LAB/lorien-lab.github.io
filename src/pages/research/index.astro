---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
const entries = (await getCollection('research')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Research · Xiang Luo" description="Quantitative research tracks spanning alpha discovery, futures term structure, and market microstructure."><header class="page-hero"><div class="container"><div class="mono-label">Research</div><h1>Questions first.<br/>Models second.</h1><p>Research tracks are organized around economic questions, data-generating mechanisms, and validation discipline rather than a collection of isolated backtests.</p></div></header><section class="section"><div class="container card-grid">{entries.map(entry=><ResearchCard entry={entry}/>)}</div></section></BaseLayout>
