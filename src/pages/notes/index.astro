---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
const entries = (await getCollection('notes', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Notes · Lorien Lab" description="Research notes on quantitative finance, statistics, market structure, and research engineering."><header class="page-hero"><div class="container"><div class="mono-label">Research Notes</div><h1>Working ideas,<br/>made explicit.</h1><p>Long-form notes for methodology, system design, paper reading, experiments, and the assumptions behind quantitative research decisions.</p></div></header><section class="section"><div class="container">{entries.map(entry=><NoteCard entry={entry}/>)}</div></section></BaseLayout>
