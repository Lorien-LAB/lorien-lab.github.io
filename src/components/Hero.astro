---
const b = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1>Turning Data Into <span>Alpha.</span></h1>
      <p>I build quantitative research systems, investigate robust signals, and design systematic strategies across futures, factor research, and machine learning.</p>
      <div class="hero-actions"><a class="button primary" href={`${b}research/`}>Explore Research <span aria-hidden="true">→</span></a><a class="button hero-button" href={`${b}projects/`}>View Projects</a><a class="button hero-button" href={`${b}cv/`}>View CV</a><a class="button hero-button" href={`${b}cv/Lorien-Lab-CV.pdf`} target="_blank" rel="noreferrer">Download PDF</a></div>
      <div class="hero-meta"><span>Financial Engineering</span><span>Quantitative Research</span><span>Research Systems</span></div>
    </div>
    <div class="hero-visual" aria-label="Abstract visualization of a quantitative research workflow">
      <svg class="signal-chart" viewBox="0 0 640 310" role="img" aria-label="Abstract signal and research trajectory visualization">
        <defs><linearGradient id="fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4ee6b1" stop-opacity=".25"/><stop offset="1" stop-color="#4ee6b1" stop-opacity="0"/></linearGradient></defs>
        <path class="area" d="M20 265 L55 253 L83 237 L112 247 L146 204 L177 218 L205 181 L236 193 L268 149 L301 161 L331 118 L359 142 L390 96 L424 119 L456 72 L486 91 L519 47 L548 59 L585 29 L620 45 L620 290 L20 290 Z"/>
        <polyline class="line primary" points="20,265 55,253 83,237 112,247 146,204 177,218 205,181 236,193 268,149 301,161 331,118 359,142 390,96 424,119 456,72 486,91 519,47 548,59 585,29 620,45"/>
        <polyline class="line benchmark" points="20,274 65,267 108,257 151,249 194,238 238,229 281,216 325,205 369,192 412,179 455,167 499,150 544,138 585,125 620,117"/>
      </svg>
      <div class="research-panel"><div class="panel-title">Research Stack</div><div class="panel-row"><span>Hypothesis</span><strong>Economic logic</strong></div><div class="panel-row"><span>Search</span><strong>LLM · GP · RL</strong></div><div class="panel-row"><span>Validation</span><strong>IC · stability · cost</strong></div><div class="panel-row"><span>Promotion</span><strong>Core factor library</strong></div></div>
      <div class="bars" aria-hidden="true">{Array.from({length:18}).map((_,i)=><i style={`--h:${20 + ((i*17)%70)}%;--d:${i*18}ms`}></i>)}</div>
    </div>
  </div>
</section>
<style>
.hero{position:relative;overflow:hidden;background:radial-gradient(circle at 75% 42%,#0b2632 0,#071621 34%,var(--hero) 68%);color:var(--hero-ink);min-height:410px}.hero-grid-bg{position:absolute;inset:0 0 0 44%;opacity:.22;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to right,transparent,#000 20%,#000)}.hero-inner{position:relative;display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:44px;min-height:410px;padding-top:30px;padding-bottom:30px}.hero-copy{position:relative;z-index:3}.hero h1{margin:0;max-width:660px;font:700 clamp(2.7rem,3.5vw,3.65rem)/1.02 var(--font-mono);letter-spacing:-.055em}.hero h1 span{color:var(--accent)}.hero-copy>p{max-width:650px;margin:24px 0 0;color:#c5d1d8;font:400 clamp(.98rem,1.3vw,1.12rem)/1.7 var(--font-mono)}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.hero-button{border-color:#52606b;background:rgba(4,14,23,.4);color:#f5f8fa}.hero-button:hover{border-color:var(--accent);color:#fff}.hero-meta{display:flex;flex-wrap:wrap;gap:17px;margin-top:28px;color:#8ea2af;font:600 .72rem var(--font-mono);text-transform:uppercase;letter-spacing:.05em}.hero-meta span+span:before{content:'•';margin-right:17px;color:var(--accent)}.hero-visual{position:relative;align-self:stretch;min-height:350px}.signal-chart{position:absolute;inset:40px 0 auto 0;width:100%;height:auto}.signal-chart .area{fill:url(#fade)}.signal-chart .line{fill:none;stroke-linecap:round;stroke-linejoin:round}.signal-chart .primary{stroke:#4ee6b1;stroke-width:3}.signal-chart .benchmark{stroke:#8799a5;stroke-width:1.2;opacity:.8}.research-panel{position:absolute;right:0;top:40px;width:210px;border:1px solid rgba(255,255,255,.15);border-radius:10px;background:rgba(6,17,29,.84);box-shadow:0 18px 50px rgba(0,0,0,.28);backdrop-filter:blur(8px)}.panel-title{padding:13px 14px;border-bottom:1px solid rgba(255,255,255,.12);font-weight:800;font-size:.84rem}.panel-row{display:flex;justify-content:space-between;gap:10px;padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.08);font-size:.7rem}.panel-row:last-child{border-bottom:0}.panel-row span{color:#8ea2af}.panel-row strong{color:var(--accent);text-align:right}.bars{position:absolute;left:5%;right:25%;bottom:22px;height:110px;display:flex;align-items:end;gap:8px;opacity:.48}.bars i{flex:1;min-width:4px;height:var(--h);background:linear-gradient(#0fd3a1,#087f69);animation:rise .9s both;animation-delay:var(--d)}@keyframes rise{from{height:0;opacity:0}to{height:var(--h);opacity:1}}
@media(max-width:980px){.hero-inner{grid-template-columns:1fr;min-height:auto;padding-top:70px}.hero-visual{min-height:330px}.hero-grid-bg{inset:45% 0 0 0}.research-panel{top:20px}.signal-chart{top:10px}}@media(max-width:640px){.hero-inner{padding-top:52px}.hero h1{font-size:clamp(2.55rem,13vw,4.1rem)}.hero-copy>p{font-size:.95rem}.hero-visual{min-height:290px;margin-top:10px}.research-panel{width:190px}.bars{right:32%;height:90px}.hero-meta{gap:10px}.hero-meta span+span:before{margin-right:10px}}
</style>
