---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import MetricBadge from './MetricBadge.astro';
import { publicContentZh } from '../data/i18n/publicContentZh';
interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const href = `${import.meta.env.BASE_URL}projects/${entry.id}/`;
const metrics = Object.entries(entry.data.metrics ?? {});
const zh = publicContentZh.projects[entry.id];
---
<a class="card project-card" href={href}>
  <div class="project-visual" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><i></i></div>
  <div class="card-body">
    <div class="card-meta"><span><span class="lang-en">{entry.data.status}</span>{zh?.status && <span class="lang-zh" lang="zh-CN">{zh.status}</span>}</span><span>{entry.data.date.getFullYear()}</span></div>
    <h3><span class="lang-en">{entry.data.title}</span>{zh?.title && <span class="lang-zh" lang="zh-CN">{zh.title}</span>}</h3>
    <p><span class="lang-en">{entry.data.description}</span>{zh?.description && <span class="lang-zh" lang="zh-CN">{zh.description}</span>}</p>
    {metrics.length > 0 && <div class="metrics">{metrics.map(([label,value]) => <MetricBadge label={label} value={value} />)}</div>}
    <TagList tags={entry.data.tags} />
  </div>
</a>
<style>
.project-card{display:block;overflow:hidden;box-shadow:none;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.project-card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--accent) 45%,var(--border));box-shadow:var(--shadow);color:var(--ink)}.project-card h3>.lang-en,.project-card h3>.lang-zh,.project-card p>.lang-en,.project-card p>.lang-zh{display:block}.project-visual{height:112px;position:relative;overflow:hidden;background:linear-gradient(135deg,#06111d,#0a2130);border-bottom:1px solid var(--border)}.project-visual:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.055) 1px,transparent 1px);background-size:24px 24px}.project-visual span{position:absolute;bottom:18px;width:12px;background:#0aa678aa;border-radius:2px 2px 0 0}.project-visual span:nth-child(1){left:15%;height:24px}.project-visual span:nth-child(2){left:27%;height:46px}.project-visual span:nth-child(3){left:42%;height:33px}.project-visual span:nth-child(4){left:61%;height:58px}.project-visual span:nth-child(5){left:77%;height:42px}.project-visual i{position:absolute;left:10%;right:9%;top:45%;height:2px;background:linear-gradient(90deg,transparent,#4ee6b1 13% 23%,transparent 24% 28%,#4ee6b1 29% 44%,transparent 45% 49%,#4ee6b1 50% 70%,transparent 71%,#4ee6b1 74% 88%,transparent);transform:skewY(-7deg);filter:drop-shadow(0 0 5px #4ee6b188)}
</style>
