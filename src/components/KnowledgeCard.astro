---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
interface Props { entry: CollectionEntry<'knowledge'>; compact?: boolean; }
const { entry, compact = false } = Astro.props;
const slug = entry.id.split('/').pop();
const href = `${import.meta.env.BASE_URL}knowledge/${slug}/`;
const typeLabel = entry.data.type === 'topic' ? 'Research Topic' : entry.data.type[0].toUpperCase() + entry.data.type.slice(1);
---
<a class:list={['knowledge-card', { compact }]} href={href}>
  <div class="knowledge-topline">
    <span class={`type type-${entry.data.type}`}>{typeLabel}</span>
    <span class={`status status-${entry.data.status}`}>{entry.data.status}</span>
  </div>
  <h3>{entry.data.title}</h3>
  <p>{entry.data.description}</p>
  <div class="knowledge-domain"><strong>{entry.data.domain}</strong><span>/</span><span>{entry.data.category}</span></div>
  {!compact && <TagList tags={entry.data.tags.slice(0, 4)} />}
  <span class="knowledge-arrow" aria-hidden="true">→</span>
</a>

<style>
.knowledge-card{position:relative;display:block;min-height:220px;padding:22px 24px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);box-shadow:none;color:var(--ink);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.knowledge-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 45%,var(--border));box-shadow:var(--shadow);color:var(--ink)}.knowledge-card.compact{min-height:0;padding:17px 18px}.knowledge-topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:17px;font:700 .68rem var(--font-mono);text-transform:uppercase;letter-spacing:.07em}.type{color:var(--accent-strong)}.type-paper{color:#b28a28}.type-tool{color:#287fbe}.type-topic{color:#8d5bc0}.status{padding:4px 7px;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.62rem}.knowledge-card h3{margin:0;font-size:1.15rem;letter-spacing:-.025em}.knowledge-card p{margin:9px 0 17px;color:var(--muted);font-size:.91rem;line-height:1.58}.knowledge-domain{display:flex;flex-wrap:wrap;gap:7px;color:var(--muted);font-size:.74rem}.knowledge-domain strong{color:var(--ink)}.knowledge-arrow{position:absolute;right:19px;bottom:17px;color:var(--accent-strong);font:800 1.1rem var(--font-mono)}.compact p{margin-bottom:12px}.compact .knowledge-arrow{bottom:13px}
</style>
