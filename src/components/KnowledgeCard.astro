---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { typeLabels, statusLabelsZh, domainLabelsZh, categoryLabelsZh, featuredKnowledgeZh } from '../data/i18n/knowledgeUi.mjs';
interface Props { entry: CollectionEntry<'knowledge'>; compact?: boolean; }
const { entry, compact = false } = Astro.props;
const slug = entry.id.split('/').pop();
const href = `${import.meta.env.BASE_URL}knowledge/${slug}/`;
const typeLabel = typeLabels[entry.data.type];
const zh = featuredKnowledgeZh[slug ?? ''];
---
<a class:list={['knowledge-card', { compact }]} href={href}>
  <div class="knowledge-topline">
    <span class={`type type-${entry.data.type}`}><span class="lang-en">{typeLabel.en}</span><span class="lang-zh" lang="zh-CN">{typeLabel.zh}</span></span>
    <span class="status"><span class="lang-en">{entry.data.status}</span><span class="lang-zh" lang="zh-CN">{statusLabelsZh[entry.data.status]}</span></span>
  </div>
  <h3>{zh ? <><span class="lang-en">{entry.data.title}</span><span class="lang-zh" lang="zh-CN">{zh.title}</span></> : entry.data.title}</h3>
  <p>{zh ? <><span class="lang-en">{entry.data.description}</span><span class="lang-zh" lang="zh-CN">{zh.description}</span></> : entry.data.description}</p>
  <div class="knowledge-domain"><strong><span class="lang-en">{entry.data.domain}</span><span class="lang-zh" lang="zh-CN">{domainLabelsZh[entry.data.domain] ?? entry.data.domain}</span></strong><span>/</span><span class="lang-en">{entry.data.category}</span><span class="lang-zh" lang="zh-CN">{categoryLabelsZh[entry.data.category] ?? entry.data.category}</span></div>
  {!compact && <TagList tags={entry.data.tags.slice(0, 3)} />}
</a>

<style>
.knowledge-card{display:block;min-height:220px;padding:22px 24px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--ink);transition:border-color .2s ease,color .2s ease}.knowledge-card:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--border));color:var(--ink)}.knowledge-card.compact{min-height:0;padding:17px 18px}.knowledge-topline{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 12px;margin-bottom:17px;font:700 .68rem var(--font-mono);text-transform:uppercase;letter-spacing:.07em}.type{color:var(--accent-strong)}.type-paper{color:#b28a28}.type-tool{color:#287fbe}.type-topic{color:#8d5bc0}.status{color:var(--muted);font-size:.68rem;font-weight:500;letter-spacing:normal;text-transform:none}.knowledge-card h3{margin:0;font-size:1.15rem;letter-spacing:-.025em}.knowledge-card p{margin:9px 0 17px;color:var(--muted);font-size:.91rem;line-height:1.58}.knowledge-domain{display:flex;flex-wrap:wrap;gap:7px;color:var(--muted);font-size:.74rem}.knowledge-domain strong{color:var(--ink)}.compact p{margin-bottom:12px}
</style>
