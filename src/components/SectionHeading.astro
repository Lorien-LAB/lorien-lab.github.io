---
interface Props { label?: string; title: string; description?: string; href?: string; linkLabel?: string; }
const { label, title, description, href, linkLabel = 'View all →' } = Astro.props;
---
<div class="section-heading">
  <div>{label && <div class="mono-label">{label}</div>}<h2>{title}</h2>{description && <p>{description}</p>}</div>
  {href && <a class="section-link" href={href}>{linkLabel}</a>}
</div>
