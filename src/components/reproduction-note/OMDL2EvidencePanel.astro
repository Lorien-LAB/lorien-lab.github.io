---
import type { OmdL2Evidence } from '../../data/reproduction-results/omd-a-share-long-only';

interface Props { data: OmdL2Evidence; }

const { data } = Astro.props;
const percent = (value: number, digits = 2) => `${(value * 100).toFixed(digits)}%`;
const ratio = (value: number, digits = 2) => value.toFixed(digits);
const money = (value: number) => new Intl.NumberFormat('en-US', {
  style: 'currency', currency: 'CNY', notation: 'compact', maximumFractionDigits: 1,
}).format(value);
const indexFields = [
  { key: 'csi300', label: 'CSI 300' },
  { key: 'csi500', label: 'CSI 500' },
  { key: 'csi1000', label: 'CSI 1000' },
  { key: 'combined', label: 'Combined' },
] as const;
const capitalRows = Object.fromEntries(data.capitalScenarios.map((scenario) => [
  scenario.key,
  {
    index: data.indexAnnualReturns.filter((row) => row.capitalKey === scenario.key),
    window: data.windowMetrics.filter((row) => row.capitalKey === scenario.key),
    benchmark: data.benchmarkComparisons.filter((row) => row.capitalKey === scenario.key),
    execution: data.execution.filter((row) => row.capitalKey === scenario.key),
  },
])) as Record<string, {
  index: (typeof data.indexAnnualReturns)[number][];
  window: (typeof data.windowMetrics)[number][];
  benchmark: (typeof data.benchmarkComparisons)[number][];
  execution: (typeof data.execution)[number][];
}>;
const barPosition = (value: number) => {
  const width = Math.min(Math.abs(value) / 0.70 * 46, 46);
  return `--bar-left:${value < 0 ? 50 - width : 50}%;--bar-width:${width}%`;
};
---

<section class="omd-evidence" data-omd-evidence aria-labelledby="omd-evidence-title">
  <div class="container record-wrap">
    <header class="evidence-intro">
      <div><div class="mono-label">L2 Reproduction Evidence</div><h2 id="omd-evidence-title">OOS1 → OOS2 Stitched</h2></div>
      <p>{data.stitchedPeriod.start} – {data.stitchedPeriod.end} · {data.stitchedPeriod.aggregation}</p>
    </header>

    <div class="headline-grid">
      {data.capitalScenarios.map((scenario) => (
        <article class:list={['headline-card', scenario.key === '100m' && 'is-primary']}>
          <span>{scenario.label}</span>
          <strong>{percent(scenario.headline.annualReturn)}</strong>
          <small>Annualized Return</small>
          <dl>
            <div><dt>Sharpe</dt><dd>{ratio(scenario.headline.sharpe)}</dd></div>
            <div><dt>Max Drawdown</dt><dd>{percent(scenario.headline.maxDrawdown)}</dd></div>
            <div><dt>Total nominal</dt><dd>{money(scenario.totalNominalCapitalCny)}</dd></div>
          </dl>
        </article>
      ))}
    </div>
    <p class="method-note">Non-overlapping OOS1 and OOS2 daily paths are concatenated. The stitched path is descriptive and does not replace independent-window robustness evidence.</p>

    <div class="capital-controls" role="group" aria-label="Capital per index sleeve">
      {data.capitalScenarios.map((scenario, index) => (
        <button type="button" data-omd-capital={scenario.key} aria-pressed={index === 0 ? 'true' : 'false'}>{scenario.label}</button>
      ))}
    </div>

    {data.capitalScenarios.map((scenario, scenarioIndex) => {
      const rows = capitalRows[scenario.key].index;
      return (
        <div class="capital-panel" data-omd-capital-panel={scenario.key} hidden={scenarioIndex !== 0}>
          <h3>Index annual returns · {scenario.label}</h3>
          <div class="bar-chart" role="img" aria-label={`OOS1 and OOS2 annual returns for ${scenario.label}`}>
            {indexFields.map((field) => (
              <div class="bar-group">
                <strong>{field.label}</strong>
                {rows.map((row) => {
                  const value = row[field.key];
                  return <div class="bar-row"><span>{row.window}</span><div class="bar-track"><i class:list={[value < 0 && 'negative']} style={barPosition(value)}></i></div><b class:list={[value < 0 && 'negative']}>{percent(value)}</b></div>;
                })}
              </div>
            ))}
          </div>
        </div>
      );
    })}

    <div class="table-wrap">
      <table><caption>Exact index and combined annual returns</caption><thead><tr><th scope="col">Window</th><th scope="col">Capital</th><th scope="col">CSI 300</th><th scope="col">CSI 500</th><th scope="col">CSI 1000</th><th scope="col">Combined</th></tr></thead>
        <tbody>{data.indexAnnualReturns.map((row) => <tr><th scope="row">{row.window}</th><td>{row.capitalKey}</td><td>{percent(row.csi300)}</td><td>{percent(row.csi500)}</td><td>{percent(row.csi1000)}</td><td>{percent(row.combined)}</td></tr>)}</tbody>
      </table>
    </div>

    <div class="table-wrap">
      <table><caption>Independent-window robustness</caption><thead><tr><th scope="col">Window</th><th scope="col">Capital</th><th scope="col">Annual return</th><th scope="col">Annualized volatility</th><th scope="col">Sharpe</th><th scope="col">Max drawdown</th><th scope="col">Calmar</th></tr></thead>
        <tbody>{data.windowMetrics.map((row) => <tr><th scope="row">{row.window}</th><td>{row.capitalKey}</td><td>{percent(row.annualReturn)}</td><td>{percent(row.annualizedVolatility)}</td><td>{ratio(row.sharpe)}</td><td>{percent(row.maxDrawdown)}</td><td>{ratio(row.calmar)}</td></tr>)}</tbody>
      </table>
    </div>

    <div class="table-wrap">
      <table><caption>Official price index / 官方价格指数 and PIT equal-weight / 时点成分股等权 comparison</caption><thead><tr><th scope="col">Window</th><th scope="col">Capital</th><th scope="col">L2</th><th scope="col">Official price index / 官方价格指数</th><th scope="col">PIT equal-weight / 时点成分股等权</th></tr></thead>
        <tbody>{data.benchmarkComparisons.map((row) => <tr><th scope="row">{row.window}</th><td>{row.capitalKey}</td><td>{percent(row.strategy)}</td><td>{percent(row.officialIndex)}</td><td>{percent(row.pitEqualWeight)}</td></tr>)}</tbody>
      </table>
      <p class="table-note">Official price index / 官方价格指数 is the official reference. The official index is close-to-close and has no modeled stock execution, costs, capacity, or capital scaling. Repeated official values in the 100m/500m rows are intentional. PIT equal-weight remains the executed exact-signal-date account using the same next-open A-share execution, modeled costs/capacity, and frozen last-close delisting convention.</p>
    </div>

    <div class="execution-grid">
      {data.execution.map((row) => <article><span>{row.window} · {row.capitalKey}</span><strong>{money(row.transactionCostCny)}</strong><small>Modeled transaction cost</small><p>{ratio(row.annualizedTwoWayTurnoverSum)}× annualized sleeve-turnover sum</p></article>)}
    </div>
    <p class="capacity-note"><strong>ADV participation cap · {percent(data.capacity.advParticipationCap, 0)}</strong> {data.capacity.note}</p>
  </div>
</section>

<script>
  document.querySelectorAll('[data-omd-evidence]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-omd-capital]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-omd-capital-panel]')];
    const select = (capital: string | undefined) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.omdCapital === capital)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.omdCapitalPanel !== capital; });
    };
    buttons.forEach((button) => {
      const activate = () => select(button.dataset.omdCapital);
      button.addEventListener('click', activate);
      button.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate();
        }
      });
    });
  });
</script>

<style>
.omd-evidence{padding:58px 0 70px;border-block:1px solid var(--border);background:color-mix(in srgb,var(--surface) 58%,var(--bg))}.evidence-intro{display:grid;grid-template-columns:1fr minmax(280px,500px);gap:44px;align-items:end;margin-bottom:28px}.evidence-intro h2{margin:8px 0 0;font-size:clamp(2rem,4vw,3.4rem);line-height:1;letter-spacing:-.055em}.evidence-intro>p{margin:0;color:var(--muted);font:600 .72rem/1.65 var(--font-mono)}.headline-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.headline-card{min-width:0;padding:24px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);box-shadow:var(--shadow)}.headline-card.is-primary{border-color:color-mix(in srgb,var(--accent) 60%,var(--border));background:linear-gradient(135deg,color-mix(in srgb,var(--accent-soft) 38%,var(--surface)),var(--surface))}.headline-card>span,.headline-card>strong,.headline-card>small{display:block}.headline-card>span{color:var(--muted);font:750 .62rem var(--font-mono);text-transform:uppercase;letter-spacing:.055em}.headline-card>strong{margin-top:13px;color:var(--accent-strong);font:850 clamp(2.8rem,6vw,5rem)/.95 var(--font-mono);letter-spacing:-.08em}.headline-card>small{margin-top:8px;color:var(--muted);font-size:.78rem}.headline-card dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:24px 0 0;padding-top:16px;border-top:1px solid var(--border)}.headline-card dt{color:var(--muted);font:650 .56rem/1.35 var(--font-mono);text-transform:uppercase;letter-spacing:.04em}.headline-card dd{margin:5px 0 0;font:780 .86rem var(--font-mono);white-space:nowrap}.capital-controls{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0 14px}.capital-controls button{min-height:42px;padding:0 14px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--muted);font:700 .68rem var(--font-mono);cursor:pointer;transition:background .18s ease,border-color .18s ease,color .18s ease}.capital-controls button:hover{border-color:var(--accent);color:var(--ink)}.capital-controls button[aria-pressed=true]{border-color:var(--accent);background:var(--accent);color:var(--hero)}.capital-panel{padding:24px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);transition:opacity .18s ease}.capital-panel[hidden]{display:none}.capital-panel h3{margin:0 0 21px;font-size:1rem;line-height:1.3}.bar-chart{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.bar-group{min-width:0}.bar-group>strong{display:block;margin-bottom:12px;font:750 .67rem var(--font-mono);color:var(--accent-strong)}.bar-row{display:grid;grid-template-columns:42px minmax(80px,1fr) 58px;gap:8px;align-items:center;margin:11px 0}.bar-row>span,.bar-row>b{font:700 .63rem var(--font-mono);white-space:nowrap}.bar-row>b{text-align:right}.bar-row>b.negative{color:var(--danger)}.bar-track{position:relative;height:10px;border-radius:999px;background:color-mix(in srgb,var(--border) 62%,transparent)}.bar-track:before{content:'';position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--muted)}.bar-track i{position:absolute;left:var(--bar-left);width:var(--bar-width);inset-block:1px;border-radius:999px;background:var(--accent)}.bar-track i.negative{background:var(--danger)}.table-wrap{max-width:100%;overflow-x:auto;margin-top:18px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}table{width:100%;min-width:760px;border-collapse:collapse}caption{padding:15px 16px 10px;text-align:left;color:var(--accent-strong);font:750 .65rem var(--font-mono);letter-spacing:.04em;text-transform:uppercase}th,td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}th{color:var(--muted);font:700 .59rem var(--font-mono);text-transform:uppercase;letter-spacing:.035em;white-space:nowrap}td{font:650 .72rem var(--font-mono);white-space:nowrap}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.table-note{margin:0;padding:12px 15px 16px;color:var(--muted);font-size:.76rem;line-height:1.6}.execution-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:18px}.execution-grid article{min-width:0;padding:16px;border-top:2px solid var(--border);background:color-mix(in srgb,var(--surface) 72%,transparent)}.execution-grid span,.execution-grid strong,.execution-grid small{display:block}.execution-grid span{color:var(--muted);font:700 .57rem var(--font-mono);text-transform:uppercase}.execution-grid strong{margin-top:8px;font:800 1.05rem var(--font-mono)}.execution-grid small{margin-top:4px;color:var(--muted);font-size:.69rem}.execution-grid p{margin:12px 0 0;color:var(--muted);font:650 .63rem var(--font-mono);line-height:1.5}.capacity-note{margin:18px 0 0;padding:15px 17px;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent-soft) 45%,var(--surface));color:var(--muted);font-size:.8rem;line-height:1.65}.capacity-note strong{color:var(--ink);font:800 .67rem var(--font-mono);text-transform:uppercase;letter-spacing:.03em}@media(max-width:900px){.evidence-intro{grid-template-columns:1fr;gap:12px}.bar-chart{grid-template-columns:1fr}.execution-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.headline-grid{grid-template-columns:1fr}.bar-row{grid-template-columns:42px minmax(150px,1fr) 62px}.headline-card dl{grid-template-columns:repeat(3,minmax(0,1fr))}.capital-controls{margin-top:21px}.capital-controls button{flex:1 1 auto}.table-wrap{max-width:100%;overflow-x:auto}}@media(max-width:430px){.headline-card{padding:20px}.headline-card>strong{font-size:clamp(2.5rem,14vw,4rem)}.headline-card dl{gap:6px}.headline-card dd{font-size:.76rem}.capital-panel{padding:18px}.bar-row{grid-template-columns:39px minmax(120px,1fr) 58px}}@media(prefers-reduced-motion:reduce){.omd-evidence *{scroll-behavior:auto!important;transition:none!important}}
.method-note{margin:2px 0 22px;padding:14px 17px;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent-soft) 38%,var(--surface));color:var(--muted);font-size:.8rem;line-height:1.65}.method-note strong{color:var(--ink)}
</style>
