---
import LanguageToggle from './LanguageToggle.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const pathname = Astro.url.pathname;
const links = [
  ['Home', '/'],
  ['Research & Projects', '/research-projects/'],
  ['Knowledge', '/knowledge/'],
  ['Notes', '/notes/'],
  ['CV', '/cv/'],
  ['About', '/about/'],
] as const;
const zhLabels: Record<(typeof links)[number][0], string> = {
  Home: '首页',
  'Research & Projects': '研究与项目',
  Knowledge: '知识库',
  Notes: '笔记',
  CV: '简历',
  About: '关于',
};
const isActive = (path: string) => path === '/' ? pathname === base || pathname === base.replace(/\/$/, '') : pathname.startsWith(withBase(path));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="Lorien Lab home / Lorien Lab 首页">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>
        <strong>Lorien Lab</strong>
        <small><span class="lang-en">Quant Research</span><span class="lang-zh" lang="zh-CN">量化研究</span></small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation / 主导航">
      {links.map(([label, path]) => (
        <a href={withBase(path)} aria-current={isActive(path) ? 'page' : undefined}>
          <span class="lang-en">{label}</span><span class="lang-zh" lang="zh-CN">{zhLabels[label]}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <LanguageToggle />
      <a class="icon-link" href="https://github.com/Lorien-LAB" target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
      </a>
      <button class="icon-button" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
      </button>
      <button class="menu-button" type="button" data-menu-button aria-controls="mobile-menu" aria-expanded="false">
        <span></span><span></span><span></span>
        <span class="sr-only lang-en">Open menu</span><span class="sr-only lang-zh" lang="zh-CN">打开菜单</span>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation / 移动端导航" data-mobile-menu>
    <div class="container">
      {links.map(([label, path]) => (
        <a href={withBase(path)} aria-current={isActive(path) ? 'page' : undefined}>
          <span class="lang-en">{label}</span><span class="lang-zh" lang="zh-CN">{zhLabels[label]}</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const menuButton = document.querySelector('[data-menu-button]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') !== 'true';
      menuButton.setAttribute('aria-expanded', String(open));
      mobileMenu?.toggleAttribute('data-open', open);
    });

    const themeButton = document.querySelector('[data-theme-toggle]');
    const updateThemeLabel = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      const zh = document.documentElement.dataset.lang === 'zh';
      themeButton?.setAttribute('aria-label', zh
        ? (dark ? '切换到浅色主题' : '切换到深色主题')
        : (dark ? 'Switch to light theme' : 'Switch to dark theme'));
    };
    updateThemeLabel();
    window.addEventListener('site-language-change', updateThemeLabel);

    themeButton?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      updateThemeLabel();
    });
  })();
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--hero) 92%, transparent); color: var(--hero-ink); border-bottom: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(14px); }
  .header-inner { min-height: 72px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; justify-self: start; color: inherit; }
  .brand:hover { color: inherit; }
  .brand strong { display: block; font-size: 1rem; line-height: 1.05; letter-spacing: -.015em; }
  .brand small { display: block; margin-top: 4px; color: var(--accent); font: 600 .72rem var(--font-mono); }
  .brand-mark { width: 31px; height: 26px; display: flex; align-items: end; gap: 4px; padding-bottom: 2px; border-bottom: 1px solid rgba(255,255,255,.3); transform: skew(-18deg); }
  .brand-mark i { width: 5px; background: var(--accent); border-radius: 2px 2px 0 0; }
  .brand-mark i:nth-child(1){height:9px}.brand-mark i:nth-child(2){height:16px}.brand-mark i:nth-child(3){height:23px}
  .desktop-nav { display: flex; align-items: center; gap: 25px; }
  .desktop-nav a { color: #d9e3ea; font-size: .84rem; font-weight: 650; }
  .desktop-nav a[aria-current='page'], .desktop-nav a:hover { color: var(--accent); }
  .header-actions { display: flex; align-items: center; justify-self: end; gap: 8px; }
  .icon-link, .icon-button, .menu-button { width: 39px; height: 39px; display: inline-grid; place-items: center; border: 0; border-radius: 9px; background: transparent; color: #eaf1f5; cursor: pointer; }
  .icon-link:hover, .icon-button:hover, .menu-button:hover { background: rgba(255,255,255,.08); color: var(--accent); }
  .icon-link svg { width: 21px; fill: currentColor; }
  .icon-button svg { width: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  html[data-theme='dark'] .icon-button .moon, html:not([data-theme='dark']) .icon-button .sun { display: none; }
  .menu-button { display: none; position: relative; }
  .menu-button span:not(.sr-only) { position: absolute; width: 19px; height: 1.5px; background: currentColor; left: 10px; transition: transform .2s ease, top .2s ease, opacity .2s ease; }
  .menu-button span:nth-child(1){top:12px}.menu-button span:nth-child(2){top:19px}.menu-button span:nth-child(3){top:26px}
  .menu-button[aria-expanded='true'] span:nth-child(1){top:19px;transform:rotate(45deg)}
  .menu-button[aria-expanded='true'] span:nth-child(2){opacity:0}
  .menu-button[aria-expanded='true'] span:nth-child(3){top:19px;transform:rotate(-45deg)}
  .mobile-nav { display: none; border-top: 1px solid rgba(255,255,255,.07); }
  .mobile-nav .container { padding: 10px 0 16px; }
  .mobile-nav a { display: block; padding: 10px 0; color: #dbe5eb; font-weight: 650; }
  .mobile-nav a[aria-current='page'] { color: var(--accent); }
  @media(max-width: 1080px) { .desktop-nav { gap: 18px; } .desktop-nav a { font-size: .8rem; } }
  @media(max-width: 980px) { .header-inner { grid-template-columns: 1fr auto; } .desktop-nav { display:none; } .menu-button { display:inline-grid; } .mobile-nav[data-open] { display:block; } }
</style>
