---
// Interactive research curves backed only by stored reproduction-run data.
// The registry is explicit so stored extension experiments are never
// presented as if they were paper-baseline reproduction curves.
import charts from '../data/reproduction-charts/stock-index-futures-roll-basis-timing.json';

interface Props { slug: string; }
const { slug } = Astro.props;

type ChartPlanItem = {
  sourceTitle: string;
  eyebrow: 'Replication' | 'Extension';
  question: string;
  note: string;
};

const chartPlan: Record<string, ChartPlanItem[]> = {
  'stock-index-futures-roll-basis-timing': [
    {
      sourceTitle: 'IC 滚贴水（3因子+迟滞+锚）',
      eyebrow: 'Extension',
      question: 'How does the filtered IC execution signal reshape roll timing?',
      note: 'Stored run: three-factor IC signal with hysteresis and a basis-level anchor. This is a later extension experiment, not the paper-baseline reproduction.',
    },
    {
      sourceTitle: 'IC 跨期套利 6x（同信号）',
      eyebrow: 'Extension',
      question: 'What happens when the same follow-on signal is applied to 6× cross-maturity arbitrage?',
      note: 'Stored run: 6× IC cross-maturity application using the same follow-on signal. It is shown as extension evidence and is not used to establish the baseline replication verdict.',
    },
  ],
};

const selectedCharts = (chartPlan[slug] ?? []).flatMap((plan) => {
  const data = charts.find((chart) => chart.title === plan.sourceTitle);
  return data ? [{ ...data, ...plan }] : [];
});
---

{selectedCharts.length > 0 && (
  <section class="repro-charts-section" aria-labelledby="selected-curves-title">
    <div class="container record-wrap">
      <div class="charts-intro">
        <div>
          <div class="mono-label">Selected Experiment Curves</div>
          <h2 id="selected-curves-title">Charts with a specific research question.</h2>
        </div>
        <p>
          The stored chart dataset currently contains follow-on experiment configurations rather than the final paper-baseline curves.
          They are therefore presented only as <strong>Extension</strong> evidence. Baseline replication is documented in the audited comparisons above.
        </p>
      </div>
      <div id="repro-charts" class="repro-charts" aria-live="off"></div>
    </div>
  </section>
)}

<style>
.repro-charts-section{padding:22px 0 64px}.charts-intro{display:grid;grid-template-columns:1fr minmax(280px,520px);gap:46px;align-items:end;margin-bottom:24px}.charts-intro h2{margin:7px 0 0;font-size:clamp(1.9rem,4vw,3rem);letter-spacing:-.05em}.charts-intro>p{margin:0;color:var(--muted);line-height:1.65}.repro-charts{display:flex;flex-direction:column;gap:24px}:global(.ichart){position:relative;padding:22px 20px 10px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);box-shadow:0 12px 36px rgba(16,40,55,.035)}:global(.ichart-context){display:grid;grid-template-columns:1fr minmax(260px,460px);gap:32px;align-items:end;margin-bottom:18px}:global(.ichart-eyebrow){font:800 .59rem var(--font-mono);letter-spacing:.06em;text-transform:uppercase;color:#4770b4}:global(.ichart-question){display:block;margin-top:6px;font-size:1.04rem;line-height:1.4}:global(.ichart-note){margin:0;color:var(--muted);font-size:.79rem;line-height:1.55}:global(.ichart-source){display:block;margin-top:5px;color:var(--muted);font:650 .62rem var(--font-mono)}:global(.ichart-head){display:flex;justify-content:flex-end;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:7px}:global(.ichart-legend){display:inline-flex;gap:7px;flex-wrap:wrap}:global(.ichart-leg-item){display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border:1px solid var(--border);border-radius:999px;background:var(--bg);color:var(--muted);font-size:.73rem;cursor:pointer;user-select:none;transition:opacity .15s,border-color .15s}:global(.ichart-leg-item:hover){border-color:var(--muted)}:global(.ichart-sw){display:inline-block;width:8px;height:8px;border-radius:50%}:global(svg.ichart-eq),:global(svg.ichart-dd){display:block;width:100%;height:auto;overflow:visible}:global(svg.ichart-eq){cursor:crosshair}:global(.ichart-grid){stroke:var(--border);stroke-width:1;opacity:.62}:global(.ichart-ylab),:global(.ichart-xlab){fill:var(--muted);font-size:10.5px;font-family:var(--font-mono);font-variant-numeric:tabular-nums}:global(.ichart-end){fill:var(--muted);font-size:10.5px}:global(.ichart-tip){position:absolute;z-index:20;display:none;min-width:170px;max-width:280px;padding:9px 11px;border:1px solid var(--border);border-radius:9px;background:var(--surface);box-shadow:var(--shadow);pointer-events:none;font-size:.76rem}:global(.tip-date){margin-bottom:5px;font-weight:750}:global(.tip-row){display:flex;align-items:center;gap:7px;margin:2px 0;color:var(--muted);white-space:nowrap}:global(.tip-row b){margin-left:auto;color:var(--ink);font:700 .72rem var(--font-mono);font-variant-numeric:tabular-nums}:global(.tip-dot){display:inline-block;width:7px;height:7px;border-radius:50%;flex-shrink:0}@media(max-width:900px){.charts-intro,:global(.ichart-context){grid-template-columns:1fr;gap:12px}}@media(max-width:560px){:global(.ichart){padding:17px 12px 8px}.repro-charts-section{padding-bottom:44px}}
</style>

<script define:vars={{ selectedCharts }}>
(function () {
  const root = document.getElementById('repro-charts');
  if (!root || !selectedCharts.length) return;

  const PALETTE = ['--accent', '--muted', '#4a7bd0'];
  const DD_COLOR = '--danger';
  const PLOT_W = 720, PLOT_H = 248, DDH = 122;
  const ML = 48, MR = 14, MT = 15, MB = 26;
  const cssColor = (token) => token.startsWith('--') ? `var(${token})` : token;

  function svgEl(tag, attrs, children) {
    const node = document.createElementNS('http://www.w3.org/2000/svg', tag);
    Object.entries(attrs || {}).forEach(([key, value]) => node.setAttribute(key, String(value)));
    (children || []).forEach((child) => node.appendChild(typeof child === 'string' ? document.createTextNode(child) : child));
    return node;
  }

  function niceTicks(min, max, count) {
    const span = Math.max(max - min, 1e-12);
    const raw = span / count;
    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const norm = raw / mag;
    const multiple = [1, 2, 2.5, 5, 10].find((item) => norm <= item) || 10;
    const step = multiple * mag;
    const ticks = [];
    for (let value = Math.ceil(min / step) * step; value <= max + 1e-9; value += step) ticks.push(value);
    return ticks;
  }

  function buildChart(cfg) {
    const wrap = document.createElement('article');
    wrap.className = 'ichart';

    const context = document.createElement('div');
    context.className = 'ichart-context';
    const question = document.createElement('div');
    const eyebrow = document.createElement('span');
    eyebrow.className = 'ichart-eyebrow';
    eyebrow.textContent = cfg.eyebrow;
    const title = document.createElement('strong');
    title.className = 'ichart-question';
    title.textContent = cfg.question;
    const source = document.createElement('span');
    source.className = 'ichart-source';
    source.textContent = `Stored configuration · ${cfg.sourceTitle}`;
    question.append(eyebrow, title, source);
    const note = document.createElement('p');
    note.className = 'ichart-note';
    note.textContent = cfg.note;
    context.append(question, note);
    wrap.appendChild(context);

    const head = document.createElement('div');
    head.className = 'ichart-head';
    const legend = document.createElement('span');
    legend.className = 'ichart-legend';
    head.appendChild(legend);
    wrap.appendChild(head);

    const t0 = new Date(cfg.dates[0]).getTime();
    const t1 = new Date(cfg.dates[cfg.dates.length - 1]).getTime();
    const span = (t1 - t0) || 1;
    const X = (date) => ML + (date.getTime() - t0) / span * (PLOT_W - ML - MR);
    const allValues = cfg.series.flatMap((series) => series.values);
    const vmin = Math.min(...allValues), vmax = Math.max(...allValues);
    const pad = (vmax - vmin) * .06 || .1;
    const Y = (value) => MT + (1 - (value - (vmin - pad)) / ((vmax + pad) - (vmin - pad))) * (PLOT_H - MT - MB);

    const svgEq = svgEl('svg', { viewBox: `0 0 ${PLOT_W} ${PLOT_H}`, class: 'ichart-eq', role: 'img', 'aria-label': cfg.question });
    svgEq.appendChild(svgEl('title', {}, [cfg.question]));

    niceTicks(vmin - pad, vmax + pad, 4).forEach((value) => {
      const y = Y(value);
      svgEq.appendChild(svgEl('line', { x1: ML, y1: y, x2: PLOT_W - MR, y2: y, class: 'ichart-grid' }));
      svgEq.appendChild(svgEl('text', { x: ML - 6, y: y + 4, class: 'ichart-ylab', 'text-anchor': 'end' }, [String(Math.round(value * 1000) / 1000)]));
    });

    [0, Math.floor((cfg.dates.length - 1) / 3), Math.floor(2 * (cfg.dates.length - 1) / 3), cfg.dates.length - 1].forEach((index) => {
      const x = X(new Date(cfg.dates[index]));
      svgEq.appendChild(svgEl('text', { x, y: PLOT_H - 7, class: 'ichart-xlab', 'text-anchor': 'middle' }, [cfg.dates[index].slice(0, 4)]));
    });

    cfg.series.forEach((series, seriesIndex) => {
      const color = cssColor(PALETTE[seriesIndex] || '--accent');
      const points = series.values.map((value, index) => `${X(new Date(cfg.dates[index]))},${Y(value)}`).join(' ');
      const path = svgEl('path', { d: `M ${points}`, fill: 'none', 'data-si': seriesIndex });
      path.setAttribute('style', `stroke:${color};stroke-width:2;stroke-linejoin:round;stroke-linecap:round;${series.dash ? 'stroke-dasharray:5 3;' : ''}`);
      svgEq.appendChild(path);

      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'ichart-leg-item';
      item.setAttribute('aria-pressed', 'true');
      const swatch = document.createElement('span');
      swatch.className = 'ichart-sw';
      swatch.style.background = color;
      const label = document.createElement('span');
      label.textContent = series.name;
      item.append(swatch, label);
      item.addEventListener('click', () => {
        const visible = item.getAttribute('aria-pressed') === 'true';
        item.setAttribute('aria-pressed', visible ? 'false' : 'true');
        item.style.opacity = visible ? '.38' : '1';
        svgEq.querySelectorAll(`[data-si="${seriesIndex}"]`).forEach((node) => { node.style.display = visible ? 'none' : ''; });
      });
      legend.appendChild(item);
    });

    const lastLabel = cfg.series.map((series) => `${series.name} ${series.values[series.values.length - 1].toFixed(2)}×`).join('  ');
    svgEq.appendChild(svgEl('text', { x: PLOT_W - MR, y: MT + 7, class: 'ichart-end', 'text-anchor': 'end' }, [lastLabel]));
    wrap.appendChild(svgEq);

    const ddMin = Math.min(...cfg.dd);
    const ddFloor = Math.min(ddMin, -1e-9);
    const ddY = (value) => MT + (1 - (value - ddFloor) / (0 - ddFloor)) * (DDH - MT - 22);
    const svgDd = svgEl('svg', { viewBox: `0 0 ${PLOT_W} ${DDH}`, class: 'ichart-dd', role: 'img', 'aria-label': `${cfg.question} drawdown` });
    niceTicks(ddFloor, 0, 3).forEach((value) => {
      const y = ddY(value);
      svgDd.appendChild(svgEl('line', { x1: ML, y1: y, x2: PLOT_W - MR, y2: y, class: 'ichart-grid' }));
      svgDd.appendChild(svgEl('text', { x: ML - 6, y: y + 4, class: 'ichart-ylab', 'text-anchor': 'end' }, [`${Math.round(value)}%`]));
    });
    const ddPath = cfg.dd.map((value, index) => `${index === 0 ? 'M' : 'L'} ${X(new Date(cfg.dates[index]))} ${ddY(value)}`).join(' ');
    const ddColor = cssColor(DD_COLOR);
    svgDd.appendChild(svgEl('path', { d: `${ddPath} L ${X(new Date(cfg.dates[cfg.dates.length - 1]))} ${DDH - 22} L ${X(new Date(cfg.dates[0]))} ${DDH - 22} Z`, style: `fill:${ddColor};fill-opacity:.12` }));
    svgDd.appendChild(svgEl('path', { d: ddPath, fill: 'none', style: `stroke:${ddColor};stroke-width:1.4` }));
    wrap.appendChild(svgDd);

    const crossEq = svgEl('line', { x1: 0, y1: MT, x2: 0, y2: PLOT_H - MB, style: 'stroke:var(--muted);stroke-width:1;stroke-dasharray:3 3;opacity:0', 'pointer-events': 'none' });
    const crossDd = svgEl('line', { x1: 0, y1: MT, x2: 0, y2: DDH - 22, style: 'stroke:var(--muted);stroke-width:1;stroke-dasharray:3 3;opacity:0', 'pointer-events': 'none' });
    const overlay = svgEl('rect', { x: ML, y: MT, width: PLOT_W - ML - MR, height: PLOT_H - MT - MB, style: 'fill:rgba(0,0,0,0);cursor:crosshair' });
    svgEq.append(overlay, crossEq);
    svgDd.appendChild(crossDd);

    const tip = document.createElement('div');
    tip.className = 'ichart-tip';
    wrap.appendChild(tip);

    const nearest = (fraction) => {
      const targetX = ML + (PLOT_W - ML - MR) * fraction;
      let best = 0, distance = Infinity;
      cfg.dates.forEach((date, index) => {
        const current = Math.abs(X(new Date(date)) - targetX);
        if (current < distance) { distance = current; best = index; }
      });
      return best;
    };

    overlay.addEventListener('mousemove', (event) => {
      const rect = svgEq.getBoundingClientRect();
      const index = nearest((event.clientX - rect.left) / rect.width);
      const x = X(new Date(cfg.dates[index]));
      crossEq.setAttribute('x1', x); crossEq.setAttribute('x2', x); crossEq.style.opacity = '1';
      crossDd.setAttribute('x1', x); crossDd.setAttribute('x2', x); crossDd.style.opacity = '1';
      tip.innerHTML = `<div class="tip-date">${cfg.dates[index]}</div>` + cfg.series.map((series, seriesIndex) => `<div class="tip-row"><span class="tip-dot" style="background:${cssColor(PALETTE[seriesIndex] || '--accent')}"></span><span>${series.name}</span><b>${series.values[index].toFixed(3)}×</b></div>`).join('') + `<div class="tip-row"><span class="tip-dot" style="background:${ddColor}"></span><span>Drawdown</span><b>${cfg.dd[index].toFixed(1)}%</b></div>`;
      tip.style.display = 'block';
      const wrapRect = wrap.getBoundingClientRect();
      const left = Math.min(Math.max(event.clientX - wrapRect.left + 12, 8), Math.max(8, wrapRect.width - 285));
      tip.style.left = `${left}px`;
      tip.style.top = `${Math.max(86, event.clientY - wrapRect.top - 24)}px`;
    });
    overlay.addEventListener('mouseleave', () => {
      crossEq.style.opacity = '0';
      crossDd.style.opacity = '0';
      tip.style.display = 'none';
    });

    root.appendChild(wrap);
  }

  selectedCharts.map(buildChart);
})();
</script>
