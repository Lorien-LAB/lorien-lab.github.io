---
interface Verdict { label: string; status: 'reproduced' | 'partial' | 'not-reproduced' | 'extension'; evidence: string; }
interface Props { verdicts: Verdict[]; }
const { verdicts } = Astro.props;
const statusLabel = { reproduced: 'REPRODUCED', partial: 'PARTIAL', 'not-reproduced': 'NOT REPRODUCED', extension: 'EXTENSION' } as const;
---
<section class="verdict-section" aria-labelledby="replication-verdict-title">
  <div class="section-head">
    <div><div class="mono-label">Replication Verdict</div><h2 id="replication-verdict-title">What actually reproduced?</h2></div>
    <p>A layer-by-layer reading of the documented evidence. Status is interpretive and is not mechanically derived from the numeric score.</p>
  </div>
  <div class="verdict-grid">
    {verdicts.map((item, index) => <article class={`verdict verdict-${item.status}`}>
      <div class="verdict-top"><span class="index">{String(index + 1).padStart(2,'0')}</span><span class="status">{statusLabel[item.status]}</span></div>
      <h3>{item.label}</h3>
      <p>{item.evidence}</p>
    </article>)}
  </div>
</section>

<style>
.verdict-section{padding:54px 0 20px}.section-head{display:grid;grid-template-columns:1fr minmax(280px,500px);gap:44px;align-items:end;margin-bottom:24px}.section-head h2{margin:7px 0 0;font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.05em}.section-head>p{margin:0;color:var(--muted);line-height:1.65}.verdict-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.verdict{min-height:190px;padding:20px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.verdict-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.index{font:700 .62rem var(--font-mono);color:var(--muted)}.status{font:800 .58rem var(--font-mono);letter-spacing:.055em;color:var(--accent-strong)}.verdict-partial .status{color:#a36c16}.verdict-not-reproduced .status{color:var(--danger)}.verdict-extension .status{color:#4770b4}.verdict h3{margin:22px 0 9px;font-size:1rem;line-height:1.3}.verdict p{margin:0;color:var(--muted);font-size:.84rem;line-height:1.6}@media(max-width:900px){.verdict-grid{grid-template-columns:1fr 1fr}.section-head{grid-template-columns:1fr}}@media(max-width:560px){.verdict-grid{grid-template-columns:1fr}.verdict{min-height:0}}
</style>
