---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import ProblemDifficulty from '../components/ProblemDifficulty.astro';

interface Props {
  problem: CollectionEntry<'problems'>;
  concepts: CollectionEntry<'knowledge'>[];
  techniques: CollectionEntry<'knowledge'>[];
  prerequisites: CollectionEntry<'knowledge'>[];
  relatedProblems: CollectionEntry<'problems'>[];
}

const { problem, concepts, techniques, prerequisites, relatedProblems } = Astro.props;
const base = import.meta.env.BASE_URL;
const slugOf = (id: string) => id.split('/').pop() ?? id;
---
<BaseLayout title={`${problem.data.title} · Lorien Lab`} description={problem.data.description}>
  <article class="problem-article">
    <header class="problem-head">
      <div class="container problem-head-grid">
        <div class="problem-title-block">
          <a class="back" href={`${base}problems/`}>← Problem Bank</a>
          <div class="mono-label">Problem · {problem.data.problemId}</div>
          <h1>{problem.data.title}</h1>
          <p class="lede">{problem.data.description}</p>
          <div class="classification">
            <span>{problem.data.category}</span>
            {problem.data.subcategories.map((item) => <span>{item}</span>)}
          </div>
          <TagList tags={problem.data.tags} />
        </div>
        <div class="difficulty-card">
          <div class="mono-label">Difficulty Profile</div>
          <ProblemDifficulty
            math={problem.data.mathDifficulty}
            insight={problem.data.insightDifficulty}
            interview={problem.data.interviewDifficulty}
          />
          {problem.data.estimatedMinutes && <p>Suggested time <strong>{problem.data.estimatedMinutes} min</strong></p>}
        </div>
      </div>
    </header>

    <div class="container problem-grid">
      <main class="prose problem-body"><slot /></main>
      <aside class="problem-sidebar" aria-label="Problem context">
        <div class="side-block">
          <div class="mono-label">Problem Map</div>
          <dl>
            <div><dt>Domain</dt><dd>{problem.data.domain}</dd></div>
            <div><dt>Category</dt><dd>{problem.data.category}</dd></div>
            <div><dt>Status</dt><dd>{problem.data.status}</dd></div>
            {problem.data.family && <div><dt>Family</dt><dd>{problem.data.family}</dd></div>}
          </dl>
        </div>

        {concepts.length > 0 && <div class="side-block">
          <h2>Concepts</h2>
          {concepts.map((entry) => <a href={`${base}knowledge/${slugOf(entry.id)}/`}><strong>{entry.data.title}</strong><span>Concept →</span></a>)}
        </div>}

        {techniques.length > 0 && <div class="side-block">
          <h2>Techniques</h2>
          {techniques.map((entry) => <a href={`${base}knowledge/${slugOf(entry.id)}/`}><strong>{entry.data.title}</strong><span>Technique →</span></a>)}
        </div>}

        {prerequisites.length > 0 && <div class="side-block">
          <h2>Prerequisites</h2>
          {prerequisites.map((entry) => <a href={`${base}knowledge/${slugOf(entry.id)}/`}><strong>{entry.data.title}</strong><span>Review →</span></a>)}
        </div>}

        {relatedProblems.length > 0 && <div class="side-block">
          <h2>Related Problems</h2>
          {relatedProblems.map((entry) => <a href={`${base}problems/${slugOf(entry.id)}/`}><strong>{entry.data.title}</strong><span>{entry.data.problemId} →</span></a>)}
        </div>}
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
.problem-head{padding:58px 0 48px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,color-mix(in srgb,var(--surface) 88%,transparent),transparent)}.problem-head-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:64px;align-items:end}.back{display:inline-block;margin-bottom:30px;color:var(--muted);font-weight:700;font-size:.86rem}.problem-title-block h1{max-width:900px;margin:12px 0 16px;font-size:clamp(2.5rem,6vw,4.8rem);line-height:.98;letter-spacing:-.06em}.lede{max-width:800px;margin:0;color:var(--muted);font-size:1.07rem;line-height:1.65}.classification{display:flex;flex-wrap:wrap;gap:8px;margin-top:19px}.classification span{padding:5px 9px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--muted);font:600 .7rem var(--font-mono)}.difficulty-card{padding:21px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.difficulty-card .mono-label{margin-bottom:15px}.difficulty-card p{margin:16px 0 0;padding-top:13px;border-top:1px solid var(--border);color:var(--muted);font-size:.78rem}.difficulty-card strong{color:var(--ink)}.problem-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:74px;align-items:start;padding-top:58px;padding-bottom:72px}.problem-body{max-width:790px;margin:0}.problem-body :global(details){margin:18px 0;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);overflow:hidden}.problem-body :global(summary){cursor:pointer;padding:14px 17px;font:700 .82rem var(--font-mono);color:var(--accent-strong);background:var(--surface-2)}.problem-body :global(details>p),.problem-body :global(details>h2),.problem-body :global(details>h3){margin-left:18px;margin-right:18px}.problem-body :global(details[open]){padding-bottom:10px}.problem-sidebar{position:sticky;top:104px}.side-block{padding:18px 0;border-top:1px solid var(--border)}.side-block:last-child{border-bottom:1px solid var(--border)}.side-block h2{margin:0 0 9px;color:var(--muted);font:700 .72rem var(--font-mono);text-transform:uppercase;letter-spacing:.06em}.side-block dl{margin:12px 0 0}.side-block dl div{display:flex;justify-content:space-between;gap:16px;padding:8px 0;border-top:1px solid var(--border);font-size:.77rem}.side-block dt{color:var(--muted)}.side-block dd{margin:0;text-align:right;font-weight:700}.side-block>a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:10px 0;border-top:1px solid var(--border);font-size:.8rem}.side-block>a span{color:var(--muted);font:600 .65rem var(--font-mono)}.side-block>a:hover strong{color:var(--accent-strong)}@media(max-width:900px){.problem-head-grid,.problem-grid{grid-template-columns:1fr}.problem-head-grid{gap:30px}.difficulty-card{max-width:480px}.problem-grid{gap:32px}.problem-sidebar{position:static}.problem-body{max-width:none}}
</style>
