---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import MetricBadge from '../components/MetricBadge.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  status: string;
  repoUrl?: string;
  docsUrl?: string;
  metrics?: Record<string, string>;
  headings: Heading[];
  backHref: string;
  backLabel: string;
}

const {
  title,
  description,
  date,
  tags,
  status,
  repoUrl,
  docsUrl,
  metrics = {},
  headings,
  backHref,
  backLabel,
} = Astro.props;

const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const metricEntries = Object.entries(metrics);
const hasActions = Boolean(repoUrl || docsUrl);
---

<BaseLayout title={`${title} · Lorien Lab`} description={description}>
  <article class="project-case-study">
    <header class="project-head">
      <div class="container project-head-inner">
        <a class="back" href={backHref}>← {backLabel}</a>
        <div class="mono-label">Project Case Study</div>
        <h1>{title}</h1>
        <p class="project-lede">{description}</p>

        <div class="project-meta">
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>{status}</span>
        </div>

        {metricEntries.length > 0 && (
          <div class="project-facts" aria-label="Project facts">
            {metricEntries.map(([label, value]) => <MetricBadge label={label} value={value} />)}
          </div>
        )}

        <TagList tags={tags} />

        {hasActions && (
          <div class="project-actions" aria-label="Project resources">
            {repoUrl && <a class="button primary" href={repoUrl} target="_blank" rel="noreferrer">Repository ↗</a>}
            {docsUrl && <a class="button" href={docsUrl} target="_blank" rel="noreferrer">Documentation ↗</a>}
          </div>
        )}
      </div>
    </header>

    <div class:list={['container', 'project-shell', outline.length === 0 && 'without-outline']}>
      {outline.length > 0 && (
        <aside class="project-outline" aria-label="Project outline">
          <div class="outline-inner">
            <div class="mono-label">Project outline</div>
            <nav>
              <ol>
                {outline.map((heading) => (
                  <li class:list={[heading.depth === 3 && 'is-subsection']}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>
      )}

      <div class="project-body">
        <div class="prose"><slot /></div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-head { padding: 62px 0 52px; border-bottom: 1px solid var(--border); }
  .project-head-inner { max-width: 1020px; }
  .back { display: inline-block; margin-bottom: 38px; color: var(--muted); font-weight: 700; font-size: .88rem; }
  .project-head h1 { max-width: 930px; margin: 11px 0 18px; font-size: clamp(2.55rem, 6vw, 4.8rem); line-height: .98; letter-spacing: -.057em; }
  .project-lede { max-width: 820px; margin: 0; color: var(--muted); font-size: clamp(1.02rem, 2vw, 1.15rem); }
  .project-meta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 24px; color: var(--muted); font: 600 .76rem var(--font-mono); }
  .project-facts { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 24px; }
  .project-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  .project-shell { display: grid; grid-template-columns: minmax(180px, 230px) minmax(0, 760px); justify-content: center; gap: clamp(34px, 6vw, 82px); padding-top: 58px; padding-bottom: 76px; }
  .project-shell.without-outline { grid-template-columns: minmax(0, 760px); }
  .project-body { min-width: 0; }
  .project-body :global(.prose) { margin: 0; }

  .project-outline { min-width: 0; }
  .outline-inner { position: sticky; top: 88px; padding: 18px 0 18px 18px; border-left: 1px solid var(--border); }
  .project-outline ol { display: grid; gap: 9px; margin: 16px 0 0; padding: 0; list-style: none; }
  .project-outline li { line-height: 1.35; }
  .project-outline li.is-subsection { padding-left: 13px; }
  .project-outline a { display: block; color: var(--muted); font-size: .82rem; font-weight: 650; }
  .project-outline li.is-subsection a { font-size: .77rem; font-weight: 550; }
  .project-outline a:hover { color: var(--accent-strong); }

  @media (max-width: 900px) {
    .project-shell { grid-template-columns: 1fr; gap: 34px; }
    .outline-inner { position: static; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
    .project-outline ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 18px; }
  }

  @media (max-width: 640px) {
    .project-head { padding: 52px 0 40px; }
    .back { margin-bottom: 30px; }
    .project-shell { padding-top: 38px; padding-bottom: 58px; }
    .project-outline ol { grid-template-columns: 1fr; }
  }
</style>
